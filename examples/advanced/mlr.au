// mlr.au — live sample cutting, tempo-locked, on a grid
//
// After mlr by Brian Crabtree (tehn) and the monome community:
//   https://github.com/monome-community/mlr
// This is an Audion re-take on the idea, not a port of their code. Thanks to
// everyone who built and kept mlr alive.
//
// Run:   audion run --ui examples/advanced/mlr.au
//
// ── How it plays ────────────────────────────────────────────────────────────
// 8 rows, each holds one sound file. A row's file is cut into SEGMENTS by
// markers you place on the waveform. Each segment gets a number of STEPS, and
// is stretched to fill exactly those steps, so a long note can take 8 steps and
// a short one 2. All segments together make the row's loop (max 16 steps).
//
// Grid (top):
//   click a cell ........ jump there on the next step (starts a stopped row)
//   drag cell A → B ..... loop between A and B
//   right-click a row ... clear its loop
//   row label ........... select the row (editor + settings on the right)
//   M ................... mute     ■ ... stop row     G1-4 ... cycle group
//   group strip ......... stop all rows in that group
//
// Editor (bottom, selected row):
//   green / red marker .. start / end: only the part between them plays
//   click waveform ...... add marker          drag marker ... move it
//   right-click marker .. delete it
//   slice (button) ...... a marker on every detected hit, snapped to steps
//   small yellow ticks .. detected hits
//   segment strip ....... left half = fewer steps, right half = more
//                         (0 steps = segment is skipped)
//
// Play:   loop       = play on, wrap at the loop end
//         once       = play to the loop end, then stop
//         trigger    = play just the pressed cell, then stop
//         pingpong   = bounce between the loop ends
//         random-all = every step jumps to any cell in the loop
//         random-4   = every step: up to 2 cells left/right, or the same cell again
//         random-2   = every step: 1 cell left/right, or the same cell again
//
// Modes:  vari    = speed and pitch move together (classic mlr)
//         beats   = every cell restarts at the file's own speed: clean drums
//         warp    = granular stretch, pitch independent ("grain" = grain size)
//         tape    = vari that glides; stop slows down, start spins up
//         cloud   = grains sprayed around the playhead ("spray")
//         stretch = pitch stays put, however much a segment is stretched
//
// Mixer: 4 groups, each with volume, reverb send, delay send and an output
// pair (1/2 … 63/64). Reverb and delay have their own output pairs. Every
// output pair ends in main volume + a limiter.
//
// A new file is checked for beats. Beaty: its beat count sets the steps, so it
// plays in tempo (moving start/end keeps it in tempo while it has one
// segment). Not beaty: the steps play it at about its own speed. Change
// either to squeeze or stretch it.
//
// Envelopes (selected row), restarted on every step:
//   amp A/D/S/R ......... volume shape; moving one switches "amp env" on
//   filter A/D/S/R ...... moves the cutoff by "env amt" (middle = none)
//   filter .............. off / lowpass / highpass / bandpass, freq + res
//                         (resonance is capped so it can't run away)
//   drive ............... up to +30 dB into the drive type: clean, analog clip,
//                         soft sine, digital clip, waveshaper; a limiter after
//
// Presets are saved next to this script as <name>__mlr.json.

bpm(120);
latency(60);    // ms ahead the engine runs; low so pad presses feel direct

// ── Settings ────────────────────────────────────────────────────────────────

let N_ROWS    = 8;
let MAX_STEPS = 16;
let PEAKS     = 880;                       // waveform resolution (= editor width)
let STEP_LENS  = [0.125, 0.25, 0.5, 1, 2, 4];             // in beats
let STEP_NAMES = ["1/32", "1/16", "1/8", "1/4", "1/2", "1 bar"];
let SPEEDS      = [0.25, 0.5, 1, 2, 4];
let SPEED_NAMES = ["÷4", "÷2", "×1", "×2", "×4"];
// How a row moves on after each step.
// Random modes must stay last (the engine checks play >= PLAY_RAND_ALL).
let PLAY_LOOP = 0;
let PLAY_ONCE = 1;
let PLAY_TRIGGER = 2;
let PLAY_PINGPONG = 3;
let PLAY_RAND_ALL = 4;
let PLAY_RAND_4 = 5;
let PLAY_RAND_2 = 6;
let PLAY_NAMES = ["loop", "once", "trigger", "pingpong", "random-all", "random-4", "random-2"];
let PLAY_TAGS  = ["", "1x", "T", "<>", "?", "?4", "?2"];      // shown on the row label
// Presets before "once" existed stored the play mode as an index into this.
let PLAY_NAMES_V1 = ["loop", "pingpong", "random-all", "random-4", "random-2"];
// Playback engines. Index = what presets store, so only ever append.
let MODE_VARI    = 0;
let MODE_STRETCH = 1;
let MODE_BEATS   = 2;
let MODE_WARP    = 3;
let MODE_TAPE    = 4;
let MODE_CLOUD   = 5;
let MODE_NAMES = ["vari", "stretch", "beats", "warp", "tape", "cloud"];
let TAPE_GLIDE = 0.25;                     // s, speed changes / spin-up
let TAPE_STOP  = 0.8;                      // s, slowing down to a halt

// warp + cloud play through grains (their own synth)
fn is_grain(mode) {
    return mode == MODE_WARP || mode == MODE_CLOUD;
}

let FILTER_NAMES = ["off", "lowpass", "highpass", "bandpass"];
let DRIVE_NAMES  = ["clean", "analog clip", "soft sine", "digital clip", "waveshaper"];
let DRIVE_MAX_DB = 30;
let DLY_BEATS = [0.25, 0.5, 0.75, 1, 1.5, 2];
let DLY_NAMES = ["1/16", "1/8", "3/16", "1/4", "3/8", "1/2"];

// Private audio buses: 4 stereo groups, reverb and delay sends, then one
// stereo bus per output pair (feeds that pair's limiter stage).
let BUS_GROUP = 300;
let BUS_REV   = 312;
let BUS_DLY   = 314;
let BUS_OUT   = 400;
let N_OUTS    = 32;                        // stereo pairs: scsynth runs with 64 outputs
let OUT_NAMES = [];
for (let i = 0; i < N_OUTS; i += 1) { push(OUT_NAMES, "" + (2 * i + 1) + "/" + (2 * i + 2)); }

// Pad press kinds.
let JUMP = 1;
let STOP = 2;

// ── Look ────────────────────────────────────────────────────────────────────
// One palette for the grid + editor canvas. The widgets get the same colors
// from [__theme] in mlr.aui — change both together.
let C_BG     = [10, 12, 14];       // window / canvas background
let C_PANEL  = [20, 23, 27];       // row labels, buttons, editor
let C_OFF    = [15, 17, 20];       // cells past the row's last step
let C_CELL_A = [30, 34, 40];       // cells, alternating per segment
let C_CELL_B = [40, 46, 54];
let C_RANGE  = [24, 70, 58];       // cells inside a loop range
let C_LINE   = [52, 60, 72];       // dim lines, waveform outside the selection
let C_TEXT   = [214, 222, 228];
let C_DIM    = [118, 128, 140];    // secondary text
let C_ACCENT = [0, 230, 160];      // playhead, start marker, active things
let C_WAVE   = [70, 190, 150];
let C_INFO   = [240, 180, 60];     // tags, hit ticks, pattern state
let C_WARN   = [255, 70, 70];      // mute, end marker
let GROUP_COLORS = [[255, 140, 40], [60, 170, 255], [140, 230, 80], [230, 90, 230]];

// ── Synths ──────────────────────────────────────────────────────────────────
// Two read heads (a/b) on the same buffer. Every jump moves the silent head
// and crossfades to it, so cuts don't click. `changed(j)` fires a head's
// phasor reset whenever its jump counter changes.
//
// Every step restarts two ADSRs: one for volume (when a_on = 1), one moving
// the filter cutoff by f_amt octaves. f_lp / f_hp / f_bp switch the lowpass,
// highpass or bandpass on (at most one is 1; all 0 = no filter). Resonance is
// limited by keeping f_rq ≥ 0.2 (set in the script).
//
// Two families: mlr_voice_* (read heads: vari, stretch, beats, tape) and
// mlr_warp_* (grains: warp, cloud), each stereo (_s) and mono (_m). `glide`
// smooths speed changes (tape). b_on/b_hold fade a beats cell out when its
// own audio runs out.
//
// Drive pushes the level up to +30 dB (d_gain) into one shape: clean,
// tanh, soft sine, hard clip or fold (d_* switches, set from the script),
// then a 5 ms lookahead limiter. Every row always runs the limiter, so all
// rows share the same 5 ms delay and stay in time with each other.

define mlr_voice_s(buf, frames, rate, glide, ja, pa, jb, pb, xf, amp, bus,
                    gt, gh, b_on, b_hold, a_on, a_atk, a_dec, a_sus, a_rel,
                    f_lp, f_hp, f_bp, f_cut, f_rq, f_gain, f_amt, f_atk, f_dec, f_sus, f_rel,
                    d_gain, d_clean, d_tanh, d_sine, d_clip, d_fold,
                    ratio, shift_on) {
    let r    = lag(rate, glide) * buf_rate_scale(buf);
    let x    = lag(xf, 0.006);
    let sa   = buf_rd(2, buf, phasor(changed(ja), r, 0, frames, pa));
    let sb   = buf_rd(2, buf, phasor(changed(jb), r, 0, frames, pb));
    let sig  = sa * (1 - x) + sb * x;
    let ps   = pitch_shift(sig, 0.1, ratio);
    let on   = lag(shift_on, 0.02);
    let dry  = sig * (1 - on) + ps * on;
    // gate: opens on every cell (gt changes), closes after gh seconds
    let trig = changed(gt);
    let since = sweep(trig, 1);
    let gate = (since < gh) * (1 - trig);
    // beats: fade out once the cell's own audio (b_hold seconds) has run out
    let bfade = lag(1 - b_on * (since > b_hold), 0.004);
    let aenv = adsr(gate, a_atk, a_dec, a_sus, a_rel) * a_on + (1 - a_on);
    let fenv = adsr(gate, f_atk, f_dec, f_sus, f_rel);
    let fc   = Clip(f_cut * LinExp(fenv * f_amt, 0, 1, 1, 2), 20, 18000);   // f_cut · 2^(env·amt)
    let filt = rlpf(dry, fc, f_rq) * f_lp + rhpf(dry, fc, f_rq) * f_hp + bpf(dry, fc, f_rq) * f_bp;
    let fon  = f_lp + f_hp + f_bp;
    let wet  = Clip(filt * f_gain, -1.5, 1.5);   // f_gain tames the resonant peak; clip = last guard
    // drive: gain, one shape (d_* switches, all 0 = clean), then a limiter
    let pre  = (dry * (1 - fon) + wet * fon) * aenv * bfade * lag(d_gain, 0.02);
    let c    = Clip(pre, -1, 1);
    let sine = c * (1.5708 - c * c * 0.6459 + c * c * c * c * 0.0797);   // ≈ sin(c·π/2)
    let shaped = pre * d_clean + tanh(pre) * d_tanh + sine * d_sine + c * d_clip + fold(pre, -1, 1) * d_fold;
    let y    = limiter(shaped, 0.97, 0.005) * lag(amp, 0.02);
    out(bus, y);
}

define mlr_voice_m(buf, frames, rate, glide, ja, pa, jb, pb, xf, amp, bus,
                    gt, gh, b_on, b_hold, a_on, a_atk, a_dec, a_sus, a_rel,
                    f_lp, f_hp, f_bp, f_cut, f_rq, f_gain, f_amt, f_atk, f_dec, f_sus, f_rel,
                    d_gain, d_clean, d_tanh, d_sine, d_clip, d_fold,
                    ratio, shift_on) {
    let r    = lag(rate, glide) * buf_rate_scale(buf);
    let x    = lag(xf, 0.006);
    let sa   = buf_rd(1, buf, phasor(changed(ja), r, 0, frames, pa));
    let sb   = buf_rd(1, buf, phasor(changed(jb), r, 0, frames, pb));
    let sig  = sa * (1 - x) + sb * x;
    let ps   = pitch_shift(sig, 0.1, ratio);
    let on   = lag(shift_on, 0.02);
    let dry  = sig * (1 - on) + ps * on;
    // gate: opens on every cell (gt changes), closes after gh seconds
    let trig = changed(gt);
    let since = sweep(trig, 1);
    let gate = (since < gh) * (1 - trig);
    // beats: fade out once the cell's own audio (b_hold seconds) has run out
    let bfade = lag(1 - b_on * (since > b_hold), 0.004);
    let aenv = adsr(gate, a_atk, a_dec, a_sus, a_rel) * a_on + (1 - a_on);
    let fenv = adsr(gate, f_atk, f_dec, f_sus, f_rel);
    let fc   = Clip(f_cut * LinExp(fenv * f_amt, 0, 1, 1, 2), 20, 18000);   // f_cut · 2^(env·amt)
    let filt = rlpf(dry, fc, f_rq) * f_lp + rhpf(dry, fc, f_rq) * f_hp + bpf(dry, fc, f_rq) * f_bp;
    let fon  = f_lp + f_hp + f_bp;
    let wet  = Clip(filt * f_gain, -1.5, 1.5);   // f_gain tames the resonant peak; clip = last guard
    // drive: gain, one shape (d_* switches, all 0 = clean), then a limiter
    let pre  = (dry * (1 - fon) + wet * fon) * aenv * bfade * lag(d_gain, 0.02);
    let c    = Clip(pre, -1, 1);
    let sine = c * (1.5708 - c * c * 0.6459 + c * c * c * c * 0.0797);   // ≈ sin(c·π/2)
    let shaped = pre * d_clean + tanh(pre) * d_tanh + sine * d_sine + c * d_clip + fold(pre, -1, 1) * d_fold;
    let y    = limiter(shaped, 0.97, 0.005) * lag(amp, 0.02);
    out(bus, pan(0, y));
}

define mlr_warp_s(buf, frames, rate, glide, ja, pa, jb, pb, xf, amp, bus,
                    gt, gh, b_on, b_hold, a_on, a_atk, a_dec, a_sus, a_rel,
                    f_lp, f_hp, f_bp, f_cut, f_rq, f_gain, f_amt, f_atk, f_dec, f_sus, f_rel,
                    d_gain, d_clean, d_tanh, d_sine, d_clip, d_fold,
                    w_freq, w_size, w_rand, w_spray) {
    let r    = lag(rate, glide) * buf_rate_scale(buf);
    let x    = lag(xf, 0.006);
    let pha  = phasor(changed(ja), r, 0, frames, pa);
    let phb  = phasor(changed(jb), r, 0, frames, pb);
    let sel  = x > 0.5;                       // grains follow the live head
    let ptr  = (pha * (1 - sel) + phb * sel) / frames + white() * w_spray;
    let dry  = warp(2, buf, ptr, w_freq, w_size, 8, w_rand);
    // gate: opens on every cell (gt changes), closes after gh seconds
    let trig = changed(gt);
    let since = sweep(trig, 1);
    let gate = (since < gh) * (1 - trig);
    // beats: fade out once the cell's own audio (b_hold seconds) has run out
    let bfade = lag(1 - b_on * (since > b_hold), 0.004);
    let aenv = adsr(gate, a_atk, a_dec, a_sus, a_rel) * a_on + (1 - a_on);
    let fenv = adsr(gate, f_atk, f_dec, f_sus, f_rel);
    let fc   = Clip(f_cut * LinExp(fenv * f_amt, 0, 1, 1, 2), 20, 18000);   // f_cut · 2^(env·amt)
    let filt = rlpf(dry, fc, f_rq) * f_lp + rhpf(dry, fc, f_rq) * f_hp + bpf(dry, fc, f_rq) * f_bp;
    let fon  = f_lp + f_hp + f_bp;
    let wet  = Clip(filt * f_gain, -1.5, 1.5);   // f_gain tames the resonant peak; clip = last guard
    // drive: gain, one shape (d_* switches, all 0 = clean), then a limiter
    let pre  = (dry * (1 - fon) + wet * fon) * aenv * bfade * lag(d_gain, 0.02);
    let c    = Clip(pre, -1, 1);
    let sine = c * (1.5708 - c * c * 0.6459 + c * c * c * c * 0.0797);   // ≈ sin(c·π/2)
    let shaped = pre * d_clean + tanh(pre) * d_tanh + sine * d_sine + c * d_clip + fold(pre, -1, 1) * d_fold;
    let y    = limiter(shaped, 0.97, 0.005) * lag(amp, 0.02);
    out(bus, y);
}

define mlr_warp_m(buf, frames, rate, glide, ja, pa, jb, pb, xf, amp, bus,
                    gt, gh, b_on, b_hold, a_on, a_atk, a_dec, a_sus, a_rel,
                    f_lp, f_hp, f_bp, f_cut, f_rq, f_gain, f_amt, f_atk, f_dec, f_sus, f_rel,
                    d_gain, d_clean, d_tanh, d_sine, d_clip, d_fold,
                    w_freq, w_size, w_rand, w_spray) {
    let r    = lag(rate, glide) * buf_rate_scale(buf);
    let x    = lag(xf, 0.006);
    let pha  = phasor(changed(ja), r, 0, frames, pa);
    let phb  = phasor(changed(jb), r, 0, frames, pb);
    let sel  = x > 0.5;                       // grains follow the live head
    let ptr  = (pha * (1 - sel) + phb * sel) / frames + white() * w_spray;
    let dry  = warp(1, buf, ptr, w_freq, w_size, 8, w_rand);
    // gate: opens on every cell (gt changes), closes after gh seconds
    let trig = changed(gt);
    let since = sweep(trig, 1);
    let gate = (since < gh) * (1 - trig);
    // beats: fade out once the cell's own audio (b_hold seconds) has run out
    let bfade = lag(1 - b_on * (since > b_hold), 0.004);
    let aenv = adsr(gate, a_atk, a_dec, a_sus, a_rel) * a_on + (1 - a_on);
    let fenv = adsr(gate, f_atk, f_dec, f_sus, f_rel);
    let fc   = Clip(f_cut * LinExp(fenv * f_amt, 0, 1, 1, 2), 20, 18000);   // f_cut · 2^(env·amt)
    let filt = rlpf(dry, fc, f_rq) * f_lp + rhpf(dry, fc, f_rq) * f_hp + bpf(dry, fc, f_rq) * f_bp;
    let fon  = f_lp + f_hp + f_bp;
    let wet  = Clip(filt * f_gain, -1.5, 1.5);   // f_gain tames the resonant peak; clip = last guard
    // drive: gain, one shape (d_* switches, all 0 = clean), then a limiter
    let pre  = (dry * (1 - fon) + wet * fon) * aenv * bfade * lag(d_gain, 0.02);
    let c    = Clip(pre, -1, 1);
    let sine = c * (1.5708 - c * c * 0.6459 + c * c * c * c * 0.0797);   // ≈ sin(c·π/2)
    let shaped = pre * d_clean + tanh(pre) * d_tanh + sine * d_sine + c * d_clip + fold(pre, -1, 1) * d_fold;
    let y    = limiter(shaped, 0.97, 0.005) * lag(amp, 0.02);
    out(bus, pan(0, y));
}

define mlr_group(inb, amp, rev, dly, outb, revb, dlyb) {
    let sig = in(inb, 2) * lag(amp, 0.05);
    out(outb, sig);
    out(revb, sig * lag(rev, 0.05));
    out(dlyb, sig * lag(dly, 0.05));
}

define mlr_reverb(inb, outb, room) {
    out(outb, reverb(in(inb, 2), 1, room, 0.5));
}

define mlr_delay(inb, outb, time, decay) {
    out(outb, comb_c(in(inb, 2), 2, lag(time, 0.1), decay));
}

// One per output pair: main volume, then a limiter so nothing can blow up.
define mlr_out(inb, hw, amp) {
    out(hw, limiter(in(inb, 2) * lag(amp, 0.05), 0.95, 0.01));
}

// ── State ───────────────────────────────────────────────────────────────────
// One flat array per field, indexed by row. Each field has one writer:
// the UI thread owns settings, a row's thread owns its playback state.

fn filled(n, v) {
    let a = [];
    for (let i = 0; i < n; i += 1) { push(a, v); }
    return a;
}

// sound file
let r_file   = filled(N_ROWS, "");
let r_buf    = filled(N_ROWS, -1);
let r_node   = filled(N_ROWS, -1);
let r_frames = filled(N_ROWS, 0);
let r_sr     = filled(N_ROWS, 44100);
let r_peaks  = filled(N_ROWS, []);
let r_onsets = filled(N_ROWS, []);         // frames of detected hits
let r_fbpm   = filled(N_ROWS, 0);          // the file's own tempo, 0 = not beaty
// segments: marks = start frame of each segment (the first is the start
// marker), steps = steps given to each segment; r_end = end marker
let r_marks  = filled(N_ROWS, [0]);
let r_steps  = filled(N_ROWS, [MAX_STEPS]);
let r_end    = filled(N_ROWS, 0);
// derived from the segments, for drawing (UI thread)
let r_total  = filled(N_ROWS, 0);
let r_mini   = filled(N_ROWS, []);         // 3 waveform bars per cell
let r_cellseg = filled(N_ROWS, []);        // segment index of each cell
// row settings (UI thread)
let r_len_i   = filled(N_ROWS, 1);         // index into STEP_LENS
let r_speed_i = filled(N_ROWS, 2);         // index into SPEEDS
let r_pitch   = filled(N_ROWS, 0);         // semitones
let r_rev     = filled(N_ROWS, false);
let r_play    = filled(N_ROWS, PLAY_LOOP);
let r_mode    = filled(N_ROWS, MODE_VARI); // index into MODE_NAMES
let r_grain   = filled(N_ROWS, 0.5);       // warp/cloud grain size, knob 0..1
let r_spray   = filled(N_ROWS, 0.3);       // cloud spray, knob 0..1
let r_chans   = filled(N_ROWS, 2);
let r_keep    = filled(N_ROWS, false);     // UI swapped the synth: keep playing
let r_grp     = filled(N_ROWS, 0);
let r_mute    = filled(N_ROWS, false);
let r_vol     = filled(N_ROWS, 0.8);
// envelopes + filter, knob positions 0..1 (see env_params)
let r_aon     = filled(N_ROWS, false);     // amp envelope on
let r_aenv    = filled(N_ROWS, [0.1, 0.5, 1, 0.3]);    // attack, decay, sustain, release
let r_fenv    = filled(N_ROWS, [0.1, 0.5, 0, 0.3]);
let r_ftype   = filled(N_ROWS, 0);         // index into FILTER_NAMES
let r_fcut    = filled(N_ROWS, 0.8);
let r_fres    = filled(N_ROWS, 0.2);
let r_famt    = filled(N_ROWS, 0.5);       // 0.5 = no envelope movement
let r_drive   = filled(N_ROWS, 0);         // knob 0..1 = 0..DRIVE_MAX_DB dB
let r_dtype   = filled(N_ROWS, 0);         // index into DRIVE_NAMES
let r_lo      = filled(N_ROWS, -1);        // loop range in steps, -1 = none
let r_hi      = filled(N_ROWS, -1);
// playback (row threads)
let r_playing = filled(N_ROWS, false);
let r_ph      = filled(N_ROWS, -1);        // playhead in steps
let r_cell    = filled(N_ROWS, -1);        // cell being played
let r_pf      = filled(N_ROWS, 0);         // playhead in frames
// pad presses, UI → row thread: write kind + step, then bump seq
let p_seq  = filled(N_ROWS, 0);
let p_kind = filled(N_ROWS, 0);
let p_step = filled(N_ROWS, 0);

// pattern recorders: events are [beat, row, kind, step]
let pat_rec    = [false, false];
let pat_play   = [false, false];
let pat_start  = [0, 0];                   // beat recording started
let pat_len    = [0, 0];                   // beats
let pat_pstart = [0, 0];                   // beat playback started
let pat_ev0 = [];
let pat_ev1 = [];

// mixer
let g_vol = [0.8, 0.8, 0.8, 0.8];
let g_rev = [0, 0, 0, 0];
let g_dly = [0, 0, 0, 0];
let g_out = [0, 0, 0, 0];                  // output pair per group
let g_node = [];
let rev_out = 0;
let dly_out = 0;
let out_nodes = [];
let main_vol = 0.8;
let rev_room = 0.6;
let dly_i = 1;
let dly_fb = 0.4;
let rev_node = -1;
let dly_node = -1;

// ── Segments ────────────────────────────────────────────────────────────────
// A segment is [f0, f1, steps, first_step, mark_index]; 0-step segments are
// left out. Total steps are capped at MAX_STEPS.

fn seg_table(marks, steps, end) {
    let segs = [];
    let cs = 0;
    let n = count(marks);
    for (let k = 0; k < n; k += 1) {
        let f0 = marks[k];
        let f1 = end;
        if (k + 1 < n) { f1 = marks[k + 1]; }
        let s = math_min(steps[k], MAX_STEPS - cs);
        if (s > 0 && f1 > f0) {
            push(segs, [f0, f1, s, cs, k]);
            cs += s;
        }
    }
    return ["segs" => segs, "total" => cs];
}

// Segment holding step position p. Moving backwards (d < 0) a position on a
// boundary belongs to the segment below it.
fn seg_at(segs, p, d) {
    let n = count(segs);
    for (let k = 0; k < n; k += 1) {
        let lo = segs[k][3];
        let hi = lo + segs[k][2];
        if (d > 0 && p >= lo && p < hi) { return k; }
        if (d < 0 && p > lo && p <= hi) { return k; }
    }
    if (d > 0) { return n - 1; }
    return 0;
}

fn frame_at(seg, p) {
    return seg[0] + (p - seg[3]) / seg[2] * (seg[1] - seg[0]);
}

// Synth params for playing `seg` (stretched to its steps) in the row's mode.
// rate is relative to the file's own speed; negative = backwards.
fn voice_params(r, seg, step_secs, spd, d) {
    let natural = (seg[1] - seg[0]) / (seg[2] * step_secs) / r_sr[r];
    let rr = natural * spd;                     // speed that fits the steps
    let pitch = math_pow(2, r_pitch[r] / 12);
    let mode = r_mode[r];
    let rate = rr * d;
    let ratio = pitch;
    if (mode == MODE_STRETCH) { ratio = pitch / rr; }
    if (mode == MODE_BEATS) {
        rate = pitch * d;                       // the file's own speed, cells restart on time
        ratio = 1;
    }
    if (is_grain(mode)) { ratio = 1; }          // grains get the pitch as w_freq
    ratio = math_clamp(ratio, 0.05, 4);
    let on = 0;
    if (mode != MODE_BEATS && !is_grain(mode) && math_abs(ratio - 1) > 0.001) { on = 1; }
    let glide = 0;
    if (mode == MODE_TAPE) { glide = TAPE_GLIDE; }
    // grains: size 20 ms .. 400 ms; cloud also sprays up to 0.5 s around the playhead
    let w_rand = 0.05;
    let w_spray = 0;
    if (mode == MODE_CLOUD) {
        w_rand = 0.4;
        w_spray = r_spray[r] * 0.5 * r_sr[r] / r_frames[r];
    }
    return ["rate" => rate, "ratio" => ratio, "shift_on" => on, "glide" => glide,
            "w_freq" => pitch, "w_size" => 0.02 * math_pow(20, r_grain[r]),
            "w_rand" => w_rand, "w_spray" => w_spray];
}

// Synth for row r: grain or read-head family, stereo or mono.
fn voice_def(r) {
    let fam = "mlr_voice_";
    if (is_grain(r_mode[r])) { fam = "mlr_warp_"; }
    if (r_chans[r] == 1) { return fam + "m"; }
    return fam + "s";
}

// Mode moved between the read-head and grain families: new synth, same row,
// keeps playing (the row thread jumps it to the playhead).
fn swap_voice(r) {
    let old = r_node[r];
    if (old < 0) { return; }
    let node = synth(voice_def(r), buf: r_buf[r], frames: r_frames[r], rate: 1, ratio: 1, shift_on: 0,
                     amp: 0, bus: BUS_GROUP + 2 * r_grp[r], d_gain: 1, d_clean: 1, w_freq: 1, w_size: 0.1);
    r_keep[r] = true;
    r_node[r] = node;
    free(old);
}

fn bool_num(b) {
    if (b) { return 1; }
    return 0;
}

// Knob 0..1 → seconds, 1 ms .. 2 s.
fn knob_time(v) {
    return 0.001 * math_pow(2000, v);
}

// Envelope + filter + drive synth params for row r, for a cell that plays
// cell_secs. The gate closes early enough for the release to finish inside it.
fn env_params(r, cell_secs) {
    let a = r_aenv[r];
    let f = r_fenv[r];
    let rel = knob_time(f[3]);
    if (r_aon[r]) { rel = knob_time(a[3]); }
    let a_on = 0;
    if (r_aon[r]) { a_on = 1; }
    return [
        "gh" => math_max(0.002, cell_secs - rel), "a_on" => a_on,
        "a_atk" => knob_time(a[0]), "a_dec" => knob_time(a[1]), "a_sus" => a[2], "a_rel" => knob_time(a[3]),
        "f_lp" => bool_num(r_ftype[r] == 1), "f_hp" => bool_num(r_ftype[r] == 2),
        "f_bp" => bool_num(r_ftype[r] == 3), "f_cut" => 20 * math_pow(900, r_fcut[r]),
        "f_rq" => 1 - 0.8 * r_fres[r], "f_gain" => math_sqrt(1 - 0.8 * r_fres[r]),
        "f_amt" => (r_famt[r] - 0.5) * 10,
        "f_atk" => knob_time(f[0]), "f_dec" => knob_time(f[1]), "f_sus" => f[2], "f_rel" => knob_time(f[3]),
        "d_gain" => math_pow(10, r_drive[r] * DRIVE_MAX_DB / 20),
        "d_clean" => bool_num(r_dtype[r] == 0), "d_tanh" => bool_num(r_dtype[r] == 1),
        "d_sine" => bool_num(r_dtype[r] == 2), "d_clip" => bool_num(r_dtype[r] == 3),
        "d_fold" => bool_num(r_dtype[r] == 4),
    ];
}

// ── Row engine ──────────────────────────────────────────────────────────────

fn record_press(t, r, kind, step) {
    if (pat_rec[0]) { push(pat_ev0, [t, r, kind, step]); }
    if (pat_rec[1]) { push(pat_ev1, [t, r, kind, step]); }
}

// The last pattern event for row r inside [t, t + span), or nil.
fn pattern_event(r, t, span) {
    let found = nil;
    for (let k = 0; k < 2; k += 1) {
        let len = pat_len[k];
        if (!pat_play[k] || pat_rec[k] || len <= 0 || t < pat_pstart[k]) { continue; }
        let phase = math_fmod(t - pat_pstart[k], len);
        let evs = pat_ev0;
        if (k == 1) { evs = pat_ev1; }
        let n = count(evs);
        for (let i = 0; i < n; i += 1) {
            let e = evs[i];
            if (e[1] != r) { continue; }
            let rel = math_fmod(math_max(0, e[0] - pat_start[k]), len);
            let hit = rel >= phase && rel < phase + span;
            if (phase + span > len && rel < phase + span - len) { hit = true; }
            if (hit) { found = [e[2], e[3]]; }
        }
    }
    return found;
}

// Next cell for the random play modes. `last` is the cell just played;
// picks wrap around inside the loop range [lo, hi).
fn random_cell(play, last, lo, hi) {
    let n = hi - lo;
    let c = lo + rand(0, n);
    if (play == PLAY_RAND_4) { c = last + rand(0, 5) - 2; }
    if (play == PLAY_RAND_2) { c = last + rand(0, 3) - 1; }
    return lo + ((c - lo) % n + n) % n;
}

fn row_loop(r) {
    let t = 0;                  // beats since start, same in every engine thread
    let p = 0;                  // position in steps
    let seen = p_seq[r];
    let last_node = -1;
    let head = 0;
    let jn = 0;
    let was_playing = false;
    let bounce = 1;             // pingpong: -1 while running against the row's direction
    let last = 0;               // cell played in the previous step
    let gt = 0;                 // envelope trigger counter
    let trig_cell = -1;         // trigger mode: the cell to play
    let env_cell = -1;          // cell the envelopes last restarted for
    let tape_off = -1;          // tape: beat at which the slowed-down row goes silent
    loop {
        let dur = STEP_LENS[r_len_i[r]];
        let rem = dur - math_fmod(t, dur);
        let node = r_node[r];
        if (node != last_node) {
            last_node = node;
            was_playing = false;           // forces a jump on the new synth
            env_cell = -1;
            if (r_keep[r]) { r_keep[r] = false; }
            else { r_playing[r] = false; }
        }
        let tab = seg_table(r_marks[r], r_steps[r], r_end[r]);
        let segs = tab["segs"];
        let total = tab["total"];
        if (node < 0 || total == 0) {
            r_ph[r] = -1;
            wait(rem);
            t += rem;
            continue;
        }

        let lo = 0;
        let hi = total;          // exclusive
        if (r_lo[r] >= 0 && r_lo[r] <= r_hi[r] && r_hi[r] < total) {
            lo = r_lo[r];
            hi = r_hi[r] + 1;
        }
        let play = r_play[r];
        if (play != PLAY_PINGPONG) { bounce = 1; }
        let d = bounce;
        if (r_rev[r]) { d = -bounce; }

        // presses: pattern first, a live press wins
        let kind = 0;
        let step = 0;
        let pe = pattern_event(r, t, rem);
        if (pe != nil) { kind = pe[0]; step = pe[1]; }
        if (p_seq[r] != seen) {
            seen = p_seq[r];
            kind = p_kind[r];
            step = p_step[r];
            record_press(t, r, kind, step);
        }
        let need_jump = false;
        if (kind == JUMP) { trig_cell = step; }
        // trigger mode = once, over just the pressed cell
        if (play == PLAY_TRIGGER && trig_cell >= 0 && trig_cell < total) {
            lo = trig_cell;
            hi = trig_cell + 1;
        }
        let stops = play == PLAY_ONCE || play == PLAY_TRIGGER;
        if (kind == STOP) { r_playing[r] = false; }
        if (kind == JUMP && step < total) {
            r_playing[r] = true;
            p = step;
            if (d < 0) { p = step + 1; }
            need_jump = true;
        }

        if (!r_playing[r]) {
            if (was_playing) {
                if (r_mode[r] == MODE_TAPE) {
                    // tape stop: slow down to a halt, silence once it's stopped
                    set(node, rate: 0, glide: TAPE_STOP);
                    tape_off = t + TAPE_STOP * bpm() / 60;
                } else {
                    set(node, amp: 0);
                }
            }
            if (tape_off >= 0 && t >= tape_off) {
                set(node, amp: 0);
                tape_off = -1;
            }
            was_playing = false;
            env_cell = -1;
            r_ph[r] = -1;
            wait(rem);
            t += rem;
            continue;
        }
        if (!was_playing) { need_jump = true; }
        was_playing = true;
        tape_off = -1;
        // a step that ended exactly on a loop end: pingpong turns around
        if (play == PLAY_PINGPONG && ((d > 0 && p >= hi - 0.000001) || (d < 0 && p <= lo + 0.000001))) {
            bounce = -bounce;
            d = -d;
        }
        let past_end = (d > 0 && (p < lo || p >= hi)) || (d < 0 && (p <= lo || p > hi));
        if (past_end && stops && kind != JUMP) {
            r_playing[r] = false;
            set(node, amp: 0);
            was_playing = false;
            r_ph[r] = -1;
            wait(rem);
            t += rem;
            continue;
        }
        if (past_end) {
            p = lo;
            if (d < 0) { p = hi; }
            need_jump = true;
        }
        // random modes pick this step's cell (a press this step wins)
        if (play >= PLAY_RAND_ALL && kind != JUMP && hi - lo > 1) {
            let c = random_cell(play, last, lo, hi);
            p = c;
            if (d < 0) { p = c + 1; }
            need_jump = true;
        }
        last = math_floor(p);
        if (d < 0) { last = math_ceil(p) - 1; }

        let spd = SPEEDS[r_speed_i[r]];
        let step_secs = dur * 60 / bpm();
        let amp = r_vol[r];
        if (r_mute[r]) { amp = 0; }
        let bus = BUS_GROUP + 2 * r_grp[r];

        // how long one cell plays at this speed: the envelope's time
        let cell_secs = step_secs / spd;

        // play through this step, stopping at every cell, segment or loop edge
        let left = rem;
        while (left > 0.000001) {
            let seg = segs[seg_at(segs, p, d)];
            let vp = voice_params(r, seg, step_secs, spd, d);
            let frame = frame_at(seg, p);
            let cell = math_floor(p + 0.000001);
            if (d < 0) { cell = math_ceil(p - 0.000001) - 1; }
            // beats: every cell restarts at its own start
            if (r_mode[r] == MODE_BEATS && cell != env_cell) { need_jump = true; }
            let jumped = need_jump;
            if (need_jump) {
                head = 1 - head;
                jn += 1;
                if (head == 0) { set(node, ja: jn, pa: frame, xf: 0); }
                else           { set(node, jb: jn, pb: frame, xf: 1); }
                need_jump = false;
            }
            set(node, rate: vp["rate"], ratio: vp["ratio"], shift_on: vp["shift_on"], glide: vp["glide"],
                w_freq: vp["w_freq"], w_size: vp["w_size"], w_rand: vp["w_rand"], w_spray: vp["w_spray"],
                amp: amp, bus: bus);
            r_ph[r] = p;
            r_pf[r] = frame;
            r_cell[r] = cell;

            // one envelope per cell: entering a new cell, or any jump (incl. a repeat)
            if (jumped || cell != env_cell) {
                let ep = env_params(r, cell_secs);
                // beats: the cell's own audio lasts this long at its natural speed
                let b_on = bool_num(r_mode[r] == MODE_BEATS);
                let b_hold = (seg[1] - seg[0]) / seg[2] / (r_sr[r] * math_abs(vp["rate"]));
                gt += 1;
                set(node, gt: gt, gh: ep["gh"], b_on: b_on, b_hold: b_hold, a_on: ep["a_on"],
                    a_atk: ep["a_atk"], a_dec: ep["a_dec"], a_sus: ep["a_sus"], a_rel: ep["a_rel"],
                    f_lp: ep["f_lp"], f_hp: ep["f_hp"], f_bp: ep["f_bp"],
                    f_cut: ep["f_cut"], f_rq: ep["f_rq"], f_gain: ep["f_gain"], f_amt: ep["f_amt"],
                    f_atk: ep["f_atk"], f_dec: ep["f_dec"], f_sus: ep["f_sus"], f_rel: ep["f_rel"],
                    d_gain: ep["d_gain"], d_clean: ep["d_clean"], d_tanh: ep["d_tanh"], d_sine: ep["d_sine"],
                    d_clip: ep["d_clip"], d_fold: ep["d_fold"]);
                env_cell = cell;
            }
            jumped = false;

            // next stop: segment or loop edge (needs a jump), or a cell border (doesn't)
            let seg_edge = math_min(seg[3] + seg[2], hi);
            let cell_edge = cell + 1;
            if (d < 0) {
                seg_edge = math_max(seg[3], lo);
                cell_edge = cell;
            }
            let edge = seg_edge;
            if ((d > 0 && cell_edge < seg_edge) || (d < 0 && cell_edge > seg_edge)) { edge = cell_edge; }
            let dt = math_abs(edge - p) / spd * dur;
            if (dt >= left - 0.000001) {
                p += d * spd * left / dur;
                wait(left);
                t += left;
                left = 0;
            } else {
                wait(dt);
                t += dt;
                left -= dt;
                p = edge;
                if (edge != seg_edge) { continue; }   // just a new cell: play on
                if ((d > 0 && p >= hi) || (d < 0 && p <= lo)) {
                    if (stops) {
                        // reached the end: silence for the rest of this step
                        r_playing[r] = false;
                        set(node, amp: 0);
                        was_playing = false;
                        r_ph[r] = -1;
                        wait(left);
                        t += left;
                        left = 0;
                        continue;
                    }
                    if (play == PLAY_PINGPONG) {
                        bounce = -bounce;
                        d = -d;
                    } else {
                        p = lo;
                        if (d < 0) { p = hi; }
                    }
                }
                need_jump = true;
            }
        }
    }
}

// Pattern recorders: notes when recording starts/stops and when playback starts.
fn pattern_clock() {
    let t = 0;
    let was_rec = [false, false];
    let was_play = [false, false];
    loop {
        for (let k = 0; k < 2; k += 1) {
            let rec = pat_rec[k];
            let play = pat_play[k];
            if (rec && !was_rec[k]) { pat_start[k] = t; }
            if (!rec && was_rec[k]) {
                pat_len[k] = math_max(1, math_ceil(t - pat_start[k]));
                pat_pstart[k] = pat_start[k];
            } else if (play && !was_play[k] && !rec) {
                pat_pstart[k] = math_ceil(t);
            }
            was_rec[k] = rec;
            was_play[k] = play;
        }
        wait(0.125);
        t += 0.125;
    }
}

fn start_row(r) {
    thread mlr_row { row_loop(r); }
}

// ── Rows: load, rebuild ─────────────────────────────────────────────────────

let status_text = "";

fn file_name(path) {
    let parts = str_explode("/", path);
    return parts[count(parts) - 1];
}

// Recompute total steps, cell → segment and the small waveform bars.
fn rebuild_row(r) {
    let frames = r_frames[r];
    let tab = seg_table(r_marks[r], r_steps[r], r_end[r]);
    let segs = tab["segs"];
    let total = tab["total"];
    let peaks = r_peaks[r];
    let top = 0.0001;
    for (let i = 0; i < count(peaks); i += 1) { top = math_max(top, peaks[i]); }
    let mini = [];
    let cellseg = [];
    for (let c = 0; c < total; c += 1) {
        push(cellseg, segs[seg_at(segs, c, 1)][4]);
        for (let j = 0; j < 3; j += 1) {
            let pa = c + j / 3;
            let pb = c + (j + 1) / 3;
            let fa = frame_at(segs[seg_at(segs, pa, 1)], pa);
            let fb = frame_at(segs[seg_at(segs, pb, -1)], pb);
            let ia = math_floor(fa / frames * PEAKS);
            let ib = math_max(ia, math_floor(fb / frames * PEAKS) - 1);
            let m = 0;
            for (let i = ia; i <= ib && i < PEAKS; i += 1) { m = math_max(m, peaks[i]); }
            push(mini, m / top);
        }
    }
    r_total[r] = total;
    r_mini[r] = mini;
    r_cellseg[r] = cellseg;
}

fn unload_row(r) {
    let old_node = r_node[r];
    let old_buf = r_buf[r];
    r_node[r] = -1;
    r_file[r] = "";
    r_total[r] = 0;
    // slice data belongs to the file
    r_marks[r] = [0];
    r_steps[r] = [MAX_STEPS];
    r_end[r] = 0;
    r_lo[r] = -1;
    r_hi[r] = -1;
    r_onsets[r] = [];
    r_fbpm[r] = 0;
    r_peaks[r] = [];
    if (old_node >= 0) { free(old_node); }
    if (old_buf >= 0) {
        sleep_ms(latency() + 100);    // let the free land before the buffer goes
        buffer_free(old_buf);
    }
    r_buf[r] = -1;
}

// Shortest step length whose 16 steps cover `beats`.
fn len_for_beats(beats) {
    let li = count(STEP_LENS) - 1;
    for (let i = count(STEP_LENS) - 1; i >= 0; i -= 1) {
        if (beats / STEP_LENS[i] <= MAX_STEPS) { li = i; }
    }
    return li;
}

// Beats between the start and end markers, 0 when the file isn't beaty.
fn sel_beats(r) {
    if (r_fbpm[r] <= 0) { return 0; }
    return (r_end[r] - r_marks[r][0]) / r_sr[r] * r_fbpm[r] / 60;
}

fn load_row(r, path) {
    unload_row(r);
    let buf = buffer_load(path);
    let info = buffer_query(buf);
    if (info == nil || info[0] <= 0) {
        status_text = "could not load " + file_name(path);
        return false;
    }
    let peaks = [];
    try { peaks = buffer_peaks(buf, PEAKS); }
    catch (e) { peaks = filled(PEAKS, 0); }
    r_buf[r] = buf;
    r_frames[r] = info[0];
    r_sr[r] = info[2];
    r_peaks[r] = peaks;
    // Beaty file: its own beat count sets the steps, so it plays in tempo.
    // Otherwise: steps that play it at about its own speed.
    let found = ["onsets" => [], "beats" => 0, "bpm" => 0];
    try { found = buffer_beats(buf); }
    catch (e) { }
    r_onsets[r] = found["onsets"];
    r_fbpm[r] = found["bpm"];
    let beats = info[0] / info[2] * bpm() / 60;
    if (found["beats"] > 0) { beats = found["beats"]; }
    let li = len_for_beats(beats);
    r_len_i[r] = li;
    r_marks[r] = [0];
    r_end[r] = info[0];
    r_steps[r] = [math_clamp(math_round(beats / STEP_LENS[li]), 1, MAX_STEPS)];
    if (r == sel) { w_step.set(li); }
    r_lo[r] = -1;
    r_hi[r] = -1;
    r_file[r] = path;
    rebuild_row(r);
    r_chans[r] = info[1];
    r_node[r] = synth(voice_def(r), buf: buf, frames: info[0], rate: 1, ratio: 1, shift_on: 0,
                      amp: 0, bus: BUS_GROUP + 2 * r_grp[r], d_gain: 1, d_clean: 1, w_freq: 1, w_size: 0.1);
    status_text = "row " + (r + 1) + ": " + file_name(path);
    if (r_fbpm[r] > 0) {
        status_text += "  (" + found["beats"] + " beats, " + math_round(r_fbpm[r] * 10) / 10 + " bpm)";
    }
    return true;
}

fn press(r, kind, step) {
    p_kind[r] = kind;
    p_step[r] = step;
    p_seq[r] += 1;
}

// ── Mixer ───────────────────────────────────────────────────────────────────

fn dly_params() {
    let secs = math_min(2, DLY_BEATS[dly_i] * 60 / bpm());
    let fb = math_clamp(dly_fb, 0.01, 0.95);
    return [secs, secs * math_log(0.001) / math_log(fb)];
}

// synth() adds to the head of the node list, so create in reverse signal
// order: output stages, effects, groups (rows are added later, in front).
fn mixer_start() {
    for (let i = 0; i < N_OUTS; i += 1) {
        push(out_nodes, synth("mlr_out", inb: BUS_OUT + 2 * i, hw: 2 * i, amp: main_vol));
    }
    rev_node = synth("mlr_reverb", inb: BUS_REV, outb: BUS_OUT + 2 * rev_out, room: rev_room);
    let dp = dly_params();
    dly_node = synth("mlr_delay", inb: BUS_DLY, outb: BUS_OUT + 2 * dly_out, time: dp[0], decay: dp[1]);
    for (let g = 0; g < 4; g += 1) {
        push(g_node, synth("mlr_group", inb: BUS_GROUP + 2 * g, amp: g_vol[g], rev: g_rev[g],
                           dly: g_dly[g], outb: BUS_OUT + 2 * g_out[g], revb: BUS_REV, dlyb: BUS_DLY));
    }
}

fn mixer_update() {
    for (let g = 0; g < 4; g += 1) {
        set(g_node[g], amp: g_vol[g], rev: g_rev[g], dly: g_dly[g], outb: BUS_OUT + 2 * g_out[g]);
    }
    set(rev_node, room: rev_room, outb: BUS_OUT + 2 * rev_out);
    let dp = dly_params();
    set(dly_node, time: dp[0], decay: dp[1], outb: BUS_OUT + 2 * dly_out);
}

fn main_update() {
    for (let i = 0; i < N_OUTS; i += 1) { set(out_nodes[i], amp: main_vol); }
}

