// ── UI: grid + editor input ─────────────────────────────────────────────────

fn cell_at(x) {
    return math_floor((x - GX) / CELL);
}

fn grid_down(r, x, button) {
    let c = cell_at(x);
    if (x >= GX && c < MAX_STEPS) {
        if (button == 1) {
            r_lo[r] = -1;
            r_hi[r] = -1;
            return;
        }
        if (c >= r_total[r]) { return; }
        if (r_lo[r] >= 0 && (c < r_lo[r] || c > r_hi[r])) {
            r_lo[r] = -1;
            r_hi[r] = -1;
        }
        press(r, JUMP, c);
        drag_row = r;
        drag_cell = c;
        return;
    }
    if (button != 0) { return; }
    if (x < GX - 4) {
        sel = r;
        sync_row_widgets();
    } else if (x >= MX && x < MX + BOX) {
        r_mute[r] = !r_mute[r];
    } else if (x >= SX && x < SX + BOX) {
        press(r, STOP, 0);
    } else if (x >= GBX && x < GBX + BOX) {
        r_grp[r] = (r_grp[r] + 1) % 4;
        if (r == sel) { w_group.set(r_grp[r]); }
    }
}

fn grid_up(x) {
    if (drag_row < 0) { return; }
    let r = drag_row;
    let c = math_clamp(cell_at(x), 0, r_total[r] - 1);
    if (c != drag_cell) {
        r_lo[r] = math_min(c, drag_cell);
        r_hi[r] = math_max(c, drag_cell);
    }
    drag_row = -1;
}

fn x_to_frame(x) {
    return math_clamp((x - EX) / EW, 0, 1) * r_frames[sel];
}

fn frame_to_x(f) {
    return EX + f / r_frames[sel] * EW;
}

// Marker within 6 px of x: its index (0 = start marker), END_MARK, or NO_MARK.
// Inner markers win over start/end when they overlap.
fn mark_near(x) {
    let marks = r_marks[sel];
    for (let k = 1; k < count(marks); k += 1) {
        if (math_abs(frame_to_x(marks[k]) - x) <= 6) { return k; }
    }
    if (math_abs(frame_to_x(marks[0]) - x) <= 6) { return 0; }
    if (math_abs(frame_to_x(r_end[sel]) - x) <= 6) { return END_MARK; }
    return NO_MARK;
}

// Beaty file with a single segment: keep it in tempo when start/end move.
fn fit_steps(r) {
    let beats = sel_beats(r);
    if (beats <= 0 || count(r_marks[r]) > 1) { return; }
    let steps = math_clamp(math_round(beats / STEP_LENS[r_len_i[r]]), 1, MAX_STEPS);
    r_steps[r] = [steps];
}

// Marker on every detected hit between start and end, snapped to the step
// grid: hits that land on the same step are merged. A beaty file also gets
// its step count from the selection's beats.
fn slice_row(r) {
    let start = r_marks[r][0];
    let end = r_end[r];
    let total = r_total[r];
    let beats = sel_beats(r);
    if (beats > 0) { total = math_clamp(math_round(beats / STEP_LENS[r_len_i[r]]), 1, MAX_STEPS); }
    let marks = [start];
    let bounds = [0];
    let onsets = r_onsets[r];
    for (let i = 0; i < count(onsets); i += 1) {
        let o = onsets[i];
        if (o <= start + 64 || o >= end - 64) { continue; }
        let b = math_round(total * (o - start) / (end - start));
        if (b > bounds[count(bounds) - 1] && b < total) {
            push(marks, o);
            push(bounds, b);
        }
    }
    if (count(marks) == 1) {
        status_text = "no hits found between the markers";
        return;
    }
    push(bounds, total);
    let steps = [];
    for (let k = 0; k + 1 < count(bounds); k += 1) { push(steps, bounds[k + 1] - bounds[k]); }
    r_marks[r] = marks;
    r_steps[r] = steps;
    r_lo[r] = -1;
    r_hi[r] = -1;
    rebuild_row(r);
    status_text = "row " + (r + 1) + ": " + count(marks) + " slices";
}

fn add_mark(x) {
    let f = math_round(x_to_frame(x));
    let marks = r_marks[sel];
    let steps = r_steps[sel];
    let n = count(marks);
    if (f < marks[0] || f > r_end[sel]) { return; }
    let k = 0;                                  // segment f falls in
    while (k + 1 < n && marks[k + 1] <= f) { k += 1; }
    let f1 = r_end[sel];
    if (k + 1 < n) { f1 = marks[k + 1]; }
    if (f - marks[k] < 64 || f1 - f < 64) { return; }
    // split the segment's steps by length, keep the total ≤ MAX_STEPS
    let s = steps[k];
    let sa = math_max(1, math_round(s * (f - marks[k]) / (f1 - marks[k])));
    let sb = math_max(1, s - sa);
    let used = 0;
    for (let i = 0; i < n; i += 1) { used += steps[i]; }
    if (used - s + sa + sb > MAX_STEPS) { sb = math_max(0, MAX_STEPS - (used - s + sa)); }
    let nm = [];
    let ns = [];
    for (let i = 0; i < n; i += 1) {
        push(nm, marks[i]);
        if (i == k) { push(ns, sa); push(nm, f); push(ns, sb); }
        else { push(ns, steps[i]); }
    }
    r_marks[sel] = nm;
    r_steps[sel] = ns;
    rebuild_row(sel);
}

fn delete_mark(k) {
    let marks = r_marks[sel];
    let steps = r_steps[sel];
    let nm = [];
    let ns = [];
    for (let i = 0; i < count(marks); i += 1) {
        if (i == k) { continue; }
        push(nm, marks[i]);
        if (i == k - 1) { push(ns, steps[i] + steps[k]); }
        else { push(ns, steps[i]); }
    }
    let used = 0;
    for (let i = 0; i < count(ns); i += 1) { used += ns[i]; }
    if (used > MAX_STEPS) { ns[k - 1] = ns[k - 1] - (used - MAX_STEPS); }
    r_marks[sel] = nm;
    r_steps[sel] = ns;
    rebuild_row(sel);
}

fn move_mark(k, x) {
    let marks = r_marks[sel];
    let n = count(marks);
    let f = math_round(x_to_frame(x));
    if (k == END_MARK) {
        r_end[sel] = math_clamp(f, marks[n - 1] + 64, r_frames[sel]);
        fit_steps(sel);
    } else {
        let lo = 0;
        if (k > 0) { lo = marks[k - 1] + 64; }
        let hi = r_end[sel] - 64;
        if (k + 1 < n) { hi = marks[k + 1] - 64; }
        marks[k] = math_clamp(f, lo, hi);
        r_marks[sel] = marks;
        if (k == 0) { fit_steps(sel); }
    }
    rebuild_row(sel);
}

// Left half of a segment in the strip = one step less, right half = one more.
fn seg_strip_click(x) {
    let f = x_to_frame(x);
    let marks = r_marks[sel];
    let steps = r_steps[sel];
    let n = count(marks);
    if (f < marks[0] || f > r_end[sel]) { return; }
    let k = 0;
    while (k + 1 < n && marks[k + 1] <= f) { k += 1; }
    let f1 = r_end[sel];
    if (k + 1 < n) { f1 = marks[k + 1]; }
    let used = 0;
    for (let i = 0; i < n; i += 1) { used += steps[i]; }
    if (x < (frame_to_x(marks[k]) + frame_to_x(f1)) / 2) {
        steps[k] = math_max(0, steps[k] - 1);
    } else if (used < MAX_STEPS) {
        steps[k] = steps[k] + 1;
    }
    r_steps[sel] = steps;
    rebuild_row(sel);
}

fn editor_down(x, y, button) {
    if (r_node[sel] < 0) { return; }
    if (y >= SEG_Y && y < SEG_Y + SEG_H) {
        if (button == 0) { seg_strip_click(x); }
        return;
    }
    let k = mark_near(x);
    if (button == 1) {
        if (k > 0) { delete_mark(k); }
        return;
    }
    if (k != NO_MARK) { drag_mark = k; }
    else { add_mark(x); }
}

fn handle_mouse() {
    let evs = cv.events();
    for (let i = 0; i < count(evs); i += 1) {
        let e = evs[i];
        let x = e["x"];
        let y = e["y"];
        if (!e["down"]) {
            if (e["button"] == 0) {
                grid_up(x);
                drag_mark = NO_MARK;
            }
            continue;
        }
        if (y >= GY && y < GY + N_ROWS * ROW_STEP) {
            let r = math_floor((y - GY) / ROW_STEP);
            if (y - GY - r * ROW_STEP < ROW_H) { grid_down(r, x, e["button"]); }
        } else if (y >= STRIP_Y && y < STRIP_Y + 26 && e["button"] == 0) {
            let g = math_floor((x - GX) / 120);
            if (x >= GX && g < 4) {
                for (let r = 0; r < N_ROWS; r += 1) {
                    if (r_grp[r] == g) { press(r, STOP, 0); }
                }
            }
        } else if (y >= EY && y < SEG_Y + SEG_H) {
            editor_down(x, y, e["button"]);
        }
    }
    if (drag_mark != NO_MARK && cv.mouse_down()) { move_mark(drag_mark, cv.mouse_x()); }
}

// ── UI: widgets ─────────────────────────────────────────────────────────────

fn refresh_presets() {
    let files = dir_scan(os_script_dir());
    preset_names = [];
    if (files) {
        for (let i = 0; i < count(files); i += 1) {
            let f = files[i];
            if (str_ends_with("__mlr.json", f)) {
                push(preset_names, str_substr(f, 0, str_length(f) - 10));
            }
        }
    }
    if (count(preset_names) == 0) { w_presets.set_options(["-"]); }
    else { w_presets.set_options(preset_names); }
}

fn preset_path(name) {
    return os_script_dir() + "/" + name + "__mlr.json";
}

fn save_preset(name) {
    let rows = [];
    for (let r = 0; r < N_ROWS; r += 1) {
        push(rows, [
            "file" => r_file[r], "marks" => r_marks[r], "steps" => r_steps[r],
            "step_len" => r_len_i[r], "speed" => r_speed_i[r], "pitch" => r_pitch[r],
            "reverse" => r_rev[r], "play" => PLAY_NAMES[r_play[r]], "mode" => r_mode[r], "group" => r_grp[r],
            "mute" => r_mute[r], "vol" => r_vol[r], "lo" => r_lo[r], "hi" => r_hi[r],
            "end" => r_end[r], "amp_env_on" => r_aon[r], "amp_env" => r_aenv[r], "flt_env" => r_fenv[r],
            "flt_type" => r_ftype[r], "flt_freq" => r_fcut[r], "flt_res" => r_fres[r], "flt_amt" => r_famt[r],
            "drive" => r_drive[r], "drive_type" => DRIVE_NAMES[r_dtype[r]],
            "grain" => r_grain[r], "spray" => r_spray[r],
        ]);
    }
    let pats = [];
    for (let k = 0; k < 2; k += 1) {
        let evs = pat_ev0;
        if (k == 1) { evs = pat_ev1; }
        let rel = [];
        for (let i = 0; i < count(evs); i += 1) {
            let e = evs[i];
            push(rel, [math_max(0, e[0] - pat_start[k]), e[1], e[2], e[3]]);
        }
        push(pats, ["len" => pat_len[k], "events" => rel]);
    }
    let data = [
        "version" => 1, "bpm" => bpm(),
        "groups" => [g_vol, g_rev, g_dly], "group_outs" => g_out,
        "rev_out" => rev_out, "dly_out" => dly_out,
        "main" => main_vol, "rev_room" => rev_room, "dly_time" => dly_i, "dly_fb" => dly_fb,
        "rows" => rows, "patterns" => pats,
    ];
    file_write(preset_path(name), json_encode(data));
    status_text = "saved " + name;
    refresh_presets();
}

// Play mode of a saved row: stored by name, or by index in older presets.
fn play_index(row) {
    if (!has_key(row, "play")) { return PLAY_LOOP; }
    let name = row["play"];
    if (name == "" + name) {
        for (let i = 0; i < count(PLAY_NAMES); i += 1) {
            if (PLAY_NAMES[i] == name) { return i; }
        }
        return PLAY_LOOP;
    }
    let old = PLAY_NAMES_V1[name];
    for (let i = 0; i < count(PLAY_NAMES); i += 1) {
        if (PLAY_NAMES[i] == old) { return i; }
    }
    return PLAY_LOOP;
}

fn load_preset(name) {
    let text = file_read(preset_path(name));
    if (!text) { status_text = "can't read " + name; return; }
    let data = json_decode(text);
    bpm(data["bpm"]);
    g_vol = data["groups"][0];
    g_rev = data["groups"][1];
    g_dly = data["groups"][2];
    main_vol = data["main"];
    rev_room = data["rev_room"];
    dly_i = data["dly_time"];
    dly_fb = data["dly_fb"];
    if (has_key(data, "group_outs")) {
        g_out = data["group_outs"];
        rev_out = data["rev_out"];
        dly_out = data["dly_out"];
    }
    mixer_update();
    main_update();
    let missing = 0;
    for (let r = 0; r < N_ROWS; r += 1) {
        let row = data["rows"][r];
        // settings that don't depend on the file (kept even if it's missing)
        r_speed_i[r] = row["speed"];
        r_pitch[r] = row["pitch"];
        r_rev[r] = row["reverse"];
        r_play[r] = play_index(row);
        r_mode[r] = row["mode"];
        r_grp[r] = row["group"];
        r_mute[r] = row["mute"];
        r_vol[r] = row["vol"];
        r_aon[r] = false;
        r_aenv[r] = [0.1, 0.5, 1, 0.3];
        r_fenv[r] = [0.1, 0.5, 0, 0.3];
        r_ftype[r] = 0;
        r_fcut[r] = 0.8;
        r_fres[r] = 0.2;
        r_famt[r] = 0.5;
        r_drive[r] = 0;
        r_dtype[r] = 0;
        r_grain[r] = 0.5;
        r_spray[r] = 0.3;
        if (has_key(row, "grain")) {
            r_grain[r] = row["grain"];
            r_spray[r] = row["spray"];
        }
        if (has_key(row, "drive")) {
            r_drive[r] = row["drive"];
            for (let i = 0; i < count(DRIVE_NAMES); i += 1) {
                if (DRIVE_NAMES[i] == row["drive_type"]) { r_dtype[r] = i; }
            }
        }
        if (has_key(row, "amp_env")) {
            r_aon[r] = row["amp_env_on"];
            r_aenv[r] = row["amp_env"];
            r_fenv[r] = row["flt_env"];
            r_ftype[r] = row["flt_type"];
            r_fcut[r] = row["flt_freq"];
            r_fres[r] = row["flt_res"];
            r_famt[r] = row["flt_amt"];
        }
        if (row["file"] == "" || !file_exists(row["file"]) || !load_row(r, row["file"])) {
            unload_row(r);
            r_len_i[r] = row["step_len"];
            if (row["file"] != "") { missing += 1; }
            continue;
        }
        // tied to the file; after load_row, which sets its own for a fresh file
        r_len_i[r] = row["step_len"];
        r_marks[r] = row["marks"];
        r_steps[r] = row["steps"];
        if (has_key(row, "end")) { r_end[r] = row["end"]; }
        r_lo[r] = row["lo"];
        r_hi[r] = row["hi"];
        rebuild_row(r);
    }
    for (let k = 0; k < 2; k += 1) {
        pat_rec[k] = false;
        pat_play[k] = false;
        pat_start[k] = 0;
        pat_len[k] = data["patterns"][k]["len"];
    }
    pat_ev0 = data["patterns"][0]["events"];
    pat_ev1 = data["patterns"][1]["events"];
    w_p1_rec.set(false); w_p1_play.set(false);
    w_p2_rec.set(false); w_p2_play.set(false);
    sync_row_widgets();
    sync_mixer_widgets();
    status_text = "loaded " + name;
    if (missing > 0) { status_text += " (" + missing + " files missing)"; }
}

fn pattern_rec_toggle(k, on) {
    if (on) {
        pat_play[k] = false;
        if (k == 0) { w_p1_play.set(false); pat_ev0 = []; }
        else        { w_p2_play.set(false); pat_ev1 = []; }
        pat_len[k] = 0;
        pat_rec[k] = true;
    } else {
        // play first, then stop recording: playback picks up seamlessly
        pat_play[k] = true;
        if (k == 0) { w_p1_play.set(true); } else { w_p2_play.set(true); }
        pat_rec[k] = false;
    }
}

fn handle_widgets() {
    if (w_file.has_changed() && w_file.value() != "") { load_row(sel, w_file.value()); }
    if (w_step.has_changed())  {
        r_len_i[sel] = int(w_step.value());
        fit_steps(sel);
        rebuild_row(sel);
    }
    if (w_speed.has_changed()) { r_speed_i[sel] = int(w_speed.value()); }
    if (w_pitch.has_changed()) { r_pitch[sel] = math_round(w_pitch.value()); }
    if (w_dir.has_changed())   { r_rev[sel] = int(w_dir.value()) == 1; }
    if (w_play.has_changed())  { r_play[sel] = int(w_play.value()); }
    if (w_mode.has_changed())  {
        let was_grain = is_grain(r_mode[sel]);
        r_mode[sel] = int(w_mode.value());
        if (is_grain(r_mode[sel]) != was_grain) { swap_voice(sel); }
    }
    if (w_grain.has_changed()) { r_grain[sel] = w_grain.value(); }
    if (w_spray.has_changed()) { r_spray[sel] = w_spray.value(); }
    if (w_group.has_changed()) { r_grp[sel] = int(w_group.value()); }
    if (w_vol.has_changed())   { r_vol[sel] = w_vol.value(); }
    if (w_slice.has_changed() && r_node[sel] >= 0) { slice_row(sel); }
    if (w_amp_on.has_changed()) { r_aon[sel] = w_amp_on.value(); }
    // moving an amp knob switches the amp envelope on
    let amp_moved = false;
    if (w_aa.has_changed()) { r_aenv[sel][0] = w_aa.value(); amp_moved = true; }
    if (w_ad.has_changed()) { r_aenv[sel][1] = w_ad.value(); amp_moved = true; }
    if (w_as.has_changed()) { r_aenv[sel][2] = w_as.value(); amp_moved = true; }
    if (w_ar.has_changed()) { r_aenv[sel][3] = w_ar.value(); amp_moved = true; }
    if (amp_moved && !r_aon[sel]) {
        r_aon[sel] = true;
        w_amp_on.set(true);
    }
    if (w_fa.has_changed()) { r_fenv[sel][0] = w_fa.value(); }
    if (w_fd.has_changed()) { r_fenv[sel][1] = w_fd.value(); }
    if (w_fs.has_changed()) { r_fenv[sel][2] = w_fs.value(); }
    if (w_fr.has_changed()) { r_fenv[sel][3] = w_fr.value(); }
    if (w_ftype.has_changed()) { r_ftype[sel] = int(w_ftype.value()); }
    if (w_fcut.has_changed()) { r_fcut[sel] = w_fcut.value(); }
    if (w_fres.has_changed()) { r_fres[sel] = w_fres.value(); }
    if (w_famt.has_changed()) { r_famt[sel] = w_famt.value(); }
    if (w_drive.has_changed()) { r_drive[sel] = w_drive.value(); }
    if (w_dtype.has_changed()) { r_dtype[sel] = int(w_dtype.value()); }

    if (w_p1_rec.has_changed())  { pattern_rec_toggle(0, w_p1_rec.value()); }
    if (w_p2_rec.has_changed())  { pattern_rec_toggle(1, w_p2_rec.value()); }
    if (w_p1_play.has_changed()) { pat_play[0] = w_p1_play.value(); }
    if (w_p2_play.has_changed()) { pat_play[1] = w_p2_play.value(); }

    if (w_save.has_changed()) {
        let name = str_trim(w_name.value());
        if (name == "") { status_text = "type a preset name first"; }
        else { save_preset(name); }
    }
    if (w_load.has_changed() && count(preset_names) > 0) {
        load_preset(preset_names[int(w_presets.value())]);
    }

    let mix = false;
    if (w_g1_vol.has_changed()) { g_vol[0] = w_g1_vol.value(); mix = true; }
    if (w_g1_rev.has_changed()) { g_rev[0] = w_g1_rev.value(); mix = true; }
    if (w_g1_dly.has_changed()) { g_dly[0] = w_g1_dly.value(); mix = true; }
    if (w_g2_vol.has_changed()) { g_vol[1] = w_g2_vol.value(); mix = true; }
    if (w_g2_rev.has_changed()) { g_rev[1] = w_g2_rev.value(); mix = true; }
    if (w_g2_dly.has_changed()) { g_dly[1] = w_g2_dly.value(); mix = true; }
    if (w_g3_vol.has_changed()) { g_vol[2] = w_g3_vol.value(); mix = true; }
    if (w_g3_rev.has_changed()) { g_rev[2] = w_g3_rev.value(); mix = true; }
    if (w_g3_dly.has_changed()) { g_dly[2] = w_g3_dly.value(); mix = true; }
    if (w_g4_vol.has_changed()) { g_vol[3] = w_g4_vol.value(); mix = true; }
    if (w_g4_rev.has_changed()) { g_rev[3] = w_g4_rev.value(); mix = true; }
    if (w_g4_dly.has_changed()) { g_dly[3] = w_g4_dly.value(); mix = true; }
    if (w_g1_out.has_changed()) { g_out[0] = int(w_g1_out.value()); mix = true; }
    if (w_g2_out.has_changed()) { g_out[1] = int(w_g2_out.value()); mix = true; }
    if (w_g3_out.has_changed()) { g_out[2] = int(w_g3_out.value()); mix = true; }
    if (w_g4_out.has_changed()) { g_out[3] = int(w_g4_out.value()); mix = true; }
    if (w_rev_out.has_changed()) { rev_out = int(w_rev_out.value()); mix = true; }
    if (w_dly_out.has_changed()) { dly_out = int(w_dly_out.value()); mix = true; }
    if (w_main.has_changed())   { main_vol = w_main.value(); main_update(); }
    if (w_room.has_changed())   { rev_room = w_room.value(); mix = true; }
    if (w_dtime.has_changed())  { dly_i = int(w_dtime.value()); mix = true; }
    if (w_dfb.has_changed())    { dly_fb = w_dfb.value(); mix = true; }
    if (w_bpm.has_changed())    { bpm(w_bpm.value()); mix = true; }
    if (mix) { mixer_update(); }
}

// ── UI: drawing ─────────────────────────────────────────────────────────────

fn box(x, y, w, h, c) { cv.rect(x, y, w, h, c[0], c[1], c[2]); }
fn txt(x, y, s, size, c) { cv.text(x, y, s, size, c[0], c[1], c[2]); }
fn ln(x1, y1, x2, y2, c, w) { cv.line(x1, y1, x2, y2, c[0], c[1], c[2], w); }

fn draw_row(r) {
    let y = GY + r * ROW_STEP;
    let gc = GROUP_COLORS[r_grp[r]];
    let total = r_total[r];

    // label
    if (r == sel) { box(4, y, GX - 10, ROW_H, C_CELL_B); }
    else { box(4, y, GX - 10, ROW_H, C_PANEL); }
    box(4, y, 3, ROW_H, gc);
    txt(14, y + 4, "" + (r + 1), 14, C_TEXT);
    txt(GX - 30, y + 4, PLAY_TAGS[r_play[r]], 11, C_INFO);
    if (r_file[r] != "") { txt(14, y + 23, str_substr(file_name(r_file[r]), 0, 9), 10, C_DIM); }

    // cells
    let cur = r_cell[r];
    if (r_ph[r] < 0) { cur = -1; }
    let mini = r_mini[r];
    let cellseg = r_cellseg[r];
    let in_range = r_lo[r] >= 0;
    for (let c = 0; c < MAX_STEPS; c += 1) {
        let x = GX + c * CELL;
        if (c >= total) {
            box(x, y, CELL - 3, ROW_H, C_OFF);
            continue;
        }
        let col = C_CELL_A;
        if (cellseg[c] % 2 == 1) { col = C_CELL_B; }
        if (in_range && c >= r_lo[r] && c <= r_hi[r]) { col = C_RANGE; }
        let bar = C_WAVE;
        if (c == cur && r_playing[r]) { col = C_ACCENT; bar = C_BG; }
        box(x, y, CELL - 3, ROW_H, col);
        if (c > 0 && cellseg[c] != cellseg[c - 1]) { box(x - 3, y, 3, ROW_H, gc); }
        let mid = y + ROW_H / 2;
        for (let j = 0; j < 3; j += 1) {
            let h = mini[c * 3 + j] * (ROW_H / 2 - 4);
            let lx = x + 8 + j * 13;
            ln(lx, mid - h, lx, mid + h, bar, 3);
        }
    }

    // mute, stop, group
    if (r_mute[r]) { box(MX, y, BOX, ROW_H, C_WARN); }
    else { box(MX, y, BOX, ROW_H, C_PANEL); }
    txt(MX + 9, y + 12, "M", 13, C_TEXT);
    if (r_playing[r]) { box(SX, y, BOX, ROW_H, C_ACCENT); box(SX + 9, y + 15, 10, 10, C_BG); }
    else { box(SX, y, BOX, ROW_H, C_PANEL); box(SX + 9, y + 15, 10, 10, C_DIM); }
    box(GBX, y, BOX, ROW_H, C_PANEL);
    box(GBX, y + ROW_H - 3, BOX, 3, gc);
    txt(GBX + 4, y + 12, "G" + (r_grp[r] + 1), 12, gc);
}

fn draw_strip() {
    for (let g = 0; g < 4; g += 1) {
        let gc = GROUP_COLORS[g];
        let x = GX + g * 120;
        box(x, STRIP_Y, 112, 26, C_PANEL);
        box(x, STRIP_Y, 3, 26, gc);
        txt(x + 12, STRIP_Y + 6, "stop G" + (g + 1), 12, C_TEXT);
    }
    let info = "";
    for (let k = 0; k < 2; k += 1) {
        let s = "off";
        if (pat_rec[k]) { s = "rec"; }
        else if (pat_play[k] && pat_len[k] > 0) { s = "play " + pat_len[k] + "b"; }
        info += "  P" + (k + 1) + ": " + s;
    }
    txt(GX + 4 * 120 + 10, STRIP_Y + 6, info, 12, C_INFO);
}

fn beat_info(r) {
    if (r_fbpm[r] <= 0) { return "   not beaty"; }
    return "   " + math_round(r_fbpm[r] * 10) / 10 + " bpm, " + math_round(sel_beats(r) * 100) / 100 + " beats selected";
}

fn draw_editor() {
    box(EX, EY, EW, EH, C_OFF);
    box(EX, SEG_Y, EW, SEG_H, C_PANEL);
    if (r_node[sel] < 0) {
        txt(EX + 12, EY + 12, "row " + (sel + 1) + ": pick a file on the right", 14, C_DIM);
        return;
    }
    let frames = r_frames[sel];
    let marks = r_marks[sel];
    let steps = r_steps[sel];
    let peaks = r_peaks[sel];
    let n = count(marks);
    let gc = GROUP_COLORS[r_grp[sel]];

    // segment backgrounds + step counts (outside start..end stays dark)
    for (let k = 0; k < n; k += 1) {
        let x0 = frame_to_x(marks[k]);
        let x1 = frame_to_x(r_end[sel]);
        if (k + 1 < n) { x1 = frame_to_x(marks[k + 1]); }
        let col = C_PANEL;
        if (k % 2 == 1) { col = C_CELL_A; }
        if (steps[k] == 0) { col = C_BG; }
        box(x0, EY, x1 - x0, EH, col);
        let cx = (x0 + x1) / 2;
        if (x1 - x0 > 54) {
            txt(x0 + 6, SEG_Y + 5, "-", 14, C_WARN);
            txt(x1 - 16, SEG_Y + 5, "+", 14, C_ACCENT);
        }
        txt(cx - 6, SEG_Y + 5, "" + steps[k], 13, C_TEXT);
    }

    // waveform
    let mid = EY + EH / 2;
    let scale = EH / 2 - 6;
    let top = 0.0001;
    for (let i = 0; i < count(peaks); i += 1) { top = math_max(top, peaks[i]); }
    let xs = frame_to_x(marks[0]);
    let xe = frame_to_x(r_end[sel]);
    for (let i = 0; i < count(peaks); i += 2) {
        let h = math_max(peaks[i], peaks[i + 1]) / top * scale;
        let x = EX + i * EW / PEAKS;
        if (x >= xs && x <= xe) { ln(x, mid - h, x, mid + h, C_WAVE, 2); }
        else { ln(x, mid - h, x, mid + h, C_LINE, 2); }
    }

    // detected hits: small ticks under the waveform
    let onsets = r_onsets[sel];
    for (let i = 0; i < count(onsets); i += 1) {
        let x = frame_to_x(onsets[i]);
        ln(x, EY + EH - 8, x, EY + EH, C_INFO, 1);
    }

    // start (green) and end (red) markers
    let ws = 2;
    if (drag_mark == 0) { ws = 4; }
    ln(xs, EY, xs, SEG_Y + SEG_H, C_ACCENT, ws);
    box(xs, EY, 10, 12, C_ACCENT);
    let we = 2;
    if (drag_mark == END_MARK) { we = 4; }
    ln(xe, EY, xe, SEG_Y + SEG_H, C_WARN, we);
    box(xe - 10, EY, 10, 12, C_WARN);

    // segment markers
    for (let k = 1; k < n; k += 1) {
        let x = frame_to_x(marks[k]);
        let w = 1;
        if (k == drag_mark) { w = 3; }
        ln(x, EY, x, SEG_Y + SEG_H, gc, w);
        box(x - 4, EY, 8, 10, gc);
    }

    // playhead
    if (r_playing[sel]) {
        let x = frame_to_x(r_pf[sel]);
        ln(x, EY, x, EY + EH, C_TEXT, 1);
    }
    let total = r_total[sel];
    txt(EX, SEG_Y + SEG_H + 8, file_name(r_file[sel]) + "   " + total + " steps x "
        + STEP_NAMES[r_len_i[sel]] + "   " + math_round(frames / r_sr[sel] * 100) / 100 + " s"
        + beat_info(sel), 12, C_DIM);
}

fn draw() {
    cv.fill(C_BG[0], C_BG[1], C_BG[2]);
    for (let r = 0; r < N_ROWS; r += 1) { draw_row(r); }
    draw_strip();
    draw_editor();
    cv.clear();    // publish this frame
}

// ── Start ───────────────────────────────────────────────────────────────────

fn main() {
    mixer_start();
    sync_row_widgets();
    sync_mixer_widgets();
    w_name.set("my_session");
    refresh_presets();

    for (let r = 0; r < N_ROWS; r += 1) { start_row(r); }
    thread mlr_patterns { pattern_clock(); }

    thread mlr_ui {
        loop {
            handle_mouse();
            handle_widgets();
            if (w_status.value() != status_text) { w_status.set(status_text); }
            draw();
            wait_ms(33);
        }
    }
}
