# ui_style_demo.aui — companion config for ui_style_demo.au
# Overrides widget defaults. Widget IDs match the first argument to ui.widgets.*().
# Inline .style() / .min() / .max() calls in the script take precedence over these.
#
# color    = [r, g, b]   0-255, accent / fill color
# bg_color = [r, g, b]   background color override
# width    = pixels       explicit widget width
# height   = pixels       explicit widget height


[tempo]
min   = 60.0
max   = 200.0
label = "Tempo (BPM)"
color = [255, 100, 30]
width = 360.0

[pitch]
min   = -24.0
max   = 24.0
label = "Pitch (semitones)"

[reverb]
label = "Reverb Mix"
color = [180, 100, 255]

[delay]
label = "Delay Time"
color = [60, 220, 140]
