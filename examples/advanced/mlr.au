fn sync_row_widgets() {
    w_row.set("row " + (sel + 1));
    w_file.set(r_file[sel]);
    w_step.set(r_len_i[sel]);
    w_speed.set(r_speed_i[sel]);
    w_pitch.set(r_pitch[sel]);
    w_dir.set(0);
    if (r_rev[sel]) { w_dir.set(1); }
    w_play.set(r_play[sel]);
    w_mode.set(r_mode[sel]);
    w_grain.set(r_grain[sel]);
    w_spray.set(r_spray[sel]);
    w_group.set(r_grp[sel]);
    w_vol.set(r_vol[sel]);
    w_amp_on.set(r_aon[sel]);
    w_aa.set(r_aenv[sel][0]); w_ad.set(r_aenv[sel][1]); w_as.set(r_aenv[sel][2]); w_ar.set(r_aenv[sel][3]);
    w_fa.set(r_fenv[sel][0]); w_fd.set(r_fenv[sel][1]); w_fs.set(r_fenv[sel][2]); w_fr.set(r_fenv[sel][3]);
    w_ftype.set(r_ftype[sel]);
    w_fcut.set(r_fcut[sel]);
    w_fres.set(r_fres[sel]);
    w_famt.set(r_famt[sel]);
    w_drive.set(r_drive[sel]);
    w_dtype.set(r_dtype[sel]);
}

fn sync_mixer_widgets() {
    w_g1_vol.set(g_vol[0]); w_g1_rev.set(g_rev[0]); w_g1_dly.set(g_dly[0]);
    w_g2_vol.set(g_vol[1]); w_g2_rev.set(g_rev[1]); w_g2_dly.set(g_dly[1]);
    w_g3_vol.set(g_vol[2]); w_g3_rev.set(g_rev[2]); w_g3_dly.set(g_dly[2]);
    w_g4_vol.set(g_vol[3]); w_g4_rev.set(g_rev[3]); w_g4_dly.set(g_dly[3]);
    w_g1_out.set(g_out[0]); w_g2_out.set(g_out[1]);
    w_g3_out.set(g_out[2]); w_g4_out.set(g_out[3]);
    w_rev_out.set(rev_out); w_dly_out.set(dly_out);
    w_main.set(main_vol);
    w_bpm.set(bpm());
    w_room.set(rev_room);
    w_dtime.set(dly_i);
    w_rtype.set(rev_type);
    w_rlpf.set(rev_lpf);
    w_dfb.set(dly_fb);
}

// ── UI: grid + editor input ─────────────────────────────────────────────────

fn cell_at(x) {
    return math_floor((x - GX) / CELL);
}

fn grid_down(r, x, button) {
    let c = cell_at(x);
    if (x >= GX && c < MAX_STEPS) {
        if (button == 1) {
            push_undo("");
            r_lo[r] = -1;
            r_hi[r] = -1;
            return;
        }
        if (c >= r_total[r]) { return; }
        if (r_lo[r] >= 0 && (c < r_lo[r] || c > r_hi[r])) {
            r_lo[r] = -1;
            r_hi[r] = -1;
        }
        press(r, JUMP, c);
        drag_row = r;
        drag_cell = c;
        return;
    }
    if (button != 0) { return; }
    if (x < GX - 4) {
        sel = r;
        sync_row_widgets();
        drag_label = r;                    // dropping it on another row swaps them
    } else if (x >= MX && x < MX + BOX) {
        push_undo("");
        r_mute[r] = !r_mute[r];
    } else if (x >= SX && x < SX + BOX) {
        press(r, STOP, 0);
    } else if (x >= GBX && x < GBX + BOX) {
        push_undo("");
        r_grp[r] = (r_grp[r] + 1) % 4;
        if (r == sel) { w_group.set(r_grp[r]); }
    }
}

// Swap all track data of two slots.
fn swap_slot(a, b) {
    let t = nil;
    t = r_file[a]; r_file[a] = r_file[b]; r_file[b] = t;
    t = r_buf[a]; r_buf[a] = r_buf[b]; r_buf[b] = t;
    t = r_node[a]; r_node[a] = r_node[b]; r_node[b] = t;
    t = r_frames[a]; r_frames[a] = r_frames[b]; r_frames[b] = t;
    t = r_sr[a]; r_sr[a] = r_sr[b]; r_sr[b] = t;
    t = r_peaks[a]; r_peaks[a] = r_peaks[b]; r_peaks[b] = t;
    t = r_onsets[a]; r_onsets[a] = r_onsets[b]; r_onsets[b] = t;
    t = r_fbpm[a]; r_fbpm[a] = r_fbpm[b]; r_fbpm[b] = t;
    t = r_marks[a]; r_marks[a] = r_marks[b]; r_marks[b] = t;
    t = r_steps[a]; r_steps[a] = r_steps[b]; r_steps[b] = t;
    t = r_end[a]; r_end[a] = r_end[b]; r_end[b] = t;
    t = r_vpts[a]; r_vpts[a] = r_vpts[b]; r_vpts[b] = t;
    t = r_vbuf[a]; r_vbuf[a] = r_vbuf[b]; r_vbuf[b] = t;
    t = r_total[a]; r_total[a] = r_total[b]; r_total[b] = t;
    t = r_mini[a]; r_mini[a] = r_mini[b]; r_mini[b] = t;
    t = r_cellseg[a]; r_cellseg[a] = r_cellseg[b]; r_cellseg[b] = t;
    t = r_len_i[a]; r_len_i[a] = r_len_i[b]; r_len_i[b] = t;
    t = r_speed_i[a]; r_speed_i[a] = r_speed_i[b]; r_speed_i[b] = t;
    t = r_pitch[a]; r_pitch[a] = r_pitch[b]; r_pitch[b] = t;
    t = r_rev[a]; r_rev[a] = r_rev[b]; r_rev[b] = t;
    t = r_play[a]; r_play[a] = r_play[b]; r_play[b] = t;
    t = r_mode[a]; r_mode[a] = r_mode[b]; r_mode[b] = t;
    t = r_grain[a]; r_grain[a] = r_grain[b]; r_grain[b] = t;
    t = r_spray[a]; r_spray[a] = r_spray[b]; r_spray[b] = t;
    t = r_chans[a]; r_chans[a] = r_chans[b]; r_chans[b] = t;
    t = r_grp[a]; r_grp[a] = r_grp[b]; r_grp[b] = t;
    t = r_mute[a]; r_mute[a] = r_mute[b]; r_mute[b] = t;
    t = r_vol[a]; r_vol[a] = r_vol[b]; r_vol[b] = t;
    t = r_aon[a]; r_aon[a] = r_aon[b]; r_aon[b] = t;
    t = r_aenv[a]; r_aenv[a] = r_aenv[b]; r_aenv[b] = t;
    t = r_fenv[a]; r_fenv[a] = r_fenv[b]; r_fenv[b] = t;
    t = r_ftype[a]; r_ftype[a] = r_ftype[b]; r_ftype[b] = t;
    t = r_fcut[a]; r_fcut[a] = r_fcut[b]; r_fcut[b] = t;
    t = r_fres[a]; r_fres[a] = r_fres[b]; r_fres[b] = t;
    t = r_famt[a]; r_famt[a] = r_famt[b]; r_famt[b] = t;
    t = r_drive[a]; r_drive[a] = r_drive[b]; r_drive[b] = t;
    t = r_dtype[a]; r_dtype[a] = r_dtype[b]; r_dtype[b] = t;
    t = r_lo[a]; r_lo[a] = r_lo[b]; r_lo[b] = t;
    t = r_hi[a]; r_hi[a] = r_hi[b]; r_hi[b] = t;
    t = r_mix[a]; r_mix[a] = r_mix[b]; r_mix[b] = t;
}

// Rows a and b trade places: their tracks (and ghosts), playing state, and
// their row numbers in recorded patterns. A playing track keeps its position.
fn swap_rows(a, b) {
    if (a == b) { return; }
    let pa = r_ph[a];
    let pb = r_ph[b];
    let play_a = r_playing[a];
    let play_b = r_playing[b];
    swap_slot(a, b);
    swap_slot(a + N_ROWS, b + N_ROWS);
    // which slot each row plays, renamed for the swap
    let ra = ps[a];
    let rb = ps[b];
    let rename = [a => b, b => a, a + N_ROWS => b + N_ROWS, b + N_ROWS => a + N_ROWS];
    ps[a] = rename[rb];
    ps[b] = rename[ra];
    // the row threads pick up the other one's track where it was
    r_playing[a] = play_b;
    r_playing[b] = play_a;
    r_keep[a] = play_b;
    r_keep[b] = play_a;
    r_hand[a] = -1;
    r_hand[b] = -1;
    if (play_b) { r_hand[a] = pb; }
    if (play_a) { r_hand[b] = pa; }
    // patterns press rows by number
    for (let k = 0; k < 2; k += 1) {
        let evs = pat_ev0;
        if (k == 1) { evs = pat_ev1; }
        for (let i = 0; i < count(evs); i += 1) {
            if (evs[i][1] == a) { evs[i][1] = b; }
            else if (evs[i][1] == b) { evs[i][1] = a; }
        }
        if (k == 0) { pat_ev0 = evs; } else { pat_ev1 = evs; }
    }
    if (sel == a) { sel = b; } else if (sel == b) { sel = a; }
    sync_row_widgets();
    status_text = "rows " + (a + 1) + " and " + (b + 1) + " swapped";
}

// Release after grabbing a row label: dropped on another row = swap.
fn label_up(y) {
    if (drag_label < 0) { return; }
    let from = drag_label;
    drag_label = -1;
    let to = math_floor((y - GY) / ROW_STEP);
    if (to >= 0 && to < N_ROWS && to != from) {
        push_undo("");
        swap_rows(from, to);
    }
}

fn grid_up(x) {
    if (drag_row < 0) { return; }
    let r = drag_row;
    let c = math_clamp(cell_at(x), 0, r_total[r] - 1);
    if (c != drag_cell) {
        push_undo("");
        r_lo[r] = math_min(c, drag_cell);
        r_hi[r] = math_max(c, drag_cell);
    }
    drag_row = -1;
}

fn x_to_frame(x) {
    return math_clamp((x - EX) / EW, 0, 1) * r_frames[sel];
}

fn frame_to_x(f) {
    return EX + f / r_frames[sel] * EW;
}

// Marker within 6 px of x: its index (0 = start marker), END_MARK, or NO_MARK.
// Inner markers win over start/end when they overlap.
fn mark_near(x) {
    let marks = r_marks[sel];
    for (let k = 1; k < count(marks); k += 1) {
        if (math_abs(frame_to_x(marks[k]) - x) <= 6) { return k; }
    }
    if (math_abs(frame_to_x(marks[0]) - x) <= 6) { return 0; }
    if (math_abs(frame_to_x(r_end[sel]) - x) <= 6) { return END_MARK; }
    return NO_MARK;
}

// Beaty file with a single segment: keep it in tempo when start/end move.
fn fit_steps(r) {
    let beats = sel_beats(r);
    if (beats <= 0 || count(r_marks[r]) > 1) { return; }
    let steps = math_clamp(math_round(beats / STEP_LENS[r_len_i[r]]), 1, MAX_STEPS);
    r_steps[r] = [steps];
}

// Marker on every detected hit between start and end, snapped to the step
// grid: hits that land on the same step are merged. A beaty file also gets
// its step count from the selection's beats.
fn slice_row(r) {
    let start = r_marks[r][0];
    let end = r_end[r];
    let total = r_total[r];
    let beats = sel_beats(r);
    if (beats > 0) { total = math_clamp(math_round(beats / STEP_LENS[r_len_i[r]]), 1, MAX_STEPS); }
    let marks = [start];
    let bounds = [0];
    let onsets = r_onsets[r];
    for (let i = 0; i < count(onsets); i += 1) {
        let o = onsets[i];
        if (o <= start + 64 || o >= end - 64) { continue; }
        let b = math_round(total * (o - start) / (end - start));
        if (b > bounds[count(bounds) - 1] && b < total) {
            push(marks, o);
            push(bounds, b);
        }
    }
    if (count(marks) == 1) {
        status_text = "no hits found between the markers";
        return;
    }
    push(bounds, total);
    let steps = [];
    for (let k = 0; k + 1 < count(bounds); k += 1) { push(steps, bounds[k + 1] - bounds[k]); }
    r_marks[r] = marks;
    r_steps[r] = steps;
    r_lo[r] = -1;
    r_hi[r] = -1;
    rebuild_row(r);
    status_text = "row " + (r + 1) + ": " + count(marks) + " slices";
}

fn add_mark(x) {
    let f = math_round(x_to_frame(x));
    let marks = r_marks[sel];
    let steps = r_steps[sel];
    let n = count(marks);
    if (f < marks[0] || f > r_end[sel]) { return; }
    let k = 0;                                  // segment f falls in
    while (k + 1 < n && marks[k + 1] <= f) { k += 1; }
    let f1 = r_end[sel];
    if (k + 1 < n) { f1 = marks[k + 1]; }
    if (f - marks[k] < 64 || f1 - f < 64) { return; }
    // split the segment's steps by length, keep the total ≤ MAX_STEPS
    let s = steps[k];
    let sa = math_max(1, math_round(s * (f - marks[k]) / (f1 - marks[k])));
    let sb = math_max(1, s - sa);
    let used = 0;
    for (let i = 0; i < n; i += 1) { used += steps[i]; }
    if (used - s + sa + sb > MAX_STEPS) { sb = math_max(0, MAX_STEPS - (used - s + sa)); }
    let nm = [];
    let ns = [];
    for (let i = 0; i < n; i += 1) {
        push(nm, marks[i]);
        if (i == k) { push(ns, sa); push(nm, f); push(ns, sb); }
        else { push(ns, steps[i]); }
    }
    r_marks[sel] = nm;
    r_steps[sel] = ns;
    rebuild_row(sel);
}

fn delete_mark(k) {
    let marks = r_marks[sel];
    let steps = r_steps[sel];
    let nm = [];
    let ns = [];
    for (let i = 0; i < count(marks); i += 1) {
        if (i == k) { continue; }
        push(nm, marks[i]);
        if (i == k - 1) { push(ns, steps[i] + steps[k]); }
        else { push(ns, steps[i]); }
    }
    let used = 0;
    for (let i = 0; i < count(ns); i += 1) { used += ns[i]; }
    if (used > MAX_STEPS) { ns[k - 1] = ns[k - 1] - (used - MAX_STEPS); }
    r_marks[sel] = nm;
    r_steps[sel] = ns;
    rebuild_row(sel);
}

fn move_mark(k, x) {
    let marks = r_marks[sel];
    let n = count(marks);
    let f = math_round(x_to_frame(x));
    if (k == END_MARK) {
        r_end[sel] = math_clamp(f, marks[n - 1] + 64, r_frames[sel]);
        fit_steps(sel);
    } else {
        let lo = 0;
        if (k > 0) { lo = marks[k - 1] + 64; }
        let hi = r_end[sel] - 64;
        if (k + 1 < n) { hi = marks[k + 1] - 64; }
        marks[k] = math_clamp(f, lo, hi);
        r_marks[sel] = marks;
        if (k == 0) { fit_steps(sel); }
    }
    rebuild_row(sel);
}

// Left half of a segment in the strip = one step less, right half = one more.
fn seg_strip_click(x) {
    let f = x_to_frame(x);
    let marks = r_marks[sel];
    let steps = r_steps[sel];
    let n = count(marks);
    if (f < marks[0] || f > r_end[sel]) { return; }
    let k = 0;
    while (k + 1 < n && marks[k + 1] <= f) { k += 1; }
    let f1 = r_end[sel];
    if (k + 1 < n) { f1 = marks[k + 1]; }
    let used = 0;
    for (let i = 0; i < n; i += 1) { used += steps[i]; }
    if (x < (frame_to_x(marks[k]) + frame_to_x(f1)) / 2) {
        steps[k] = math_max(0, steps[k] - 1);
    } else if (used < MAX_STEPS) {
        steps[k] = steps[k] + 1;
    }
    r_steps[sel] = steps;
    rebuild_row(sel);
}

// Volume curve geometry: level 1 at the top of the waveform, 0 at the bottom.
fn vol_y(level) {
    return EY + 6 + (1 - level) * (EH - 12);
}

fn y_vol(y) {
    return math_clamp(1 - (y - EY - 6) / (EH - 12), 0, 1);
}

// Index of the volume point within 7 px of (x, y), or -1.
fn vol_point_near(x, y) {
    let pts = r_vpts[sel];
    for (let i = 0; i < count(pts); i += 1) {
        if (math_abs(frame_to_x(pts[i][0]) - x) <= 7 && math_abs(vol_y(pts[i][1]) - y) <= 7) { return i; }
    }
    return -1;
}

// New point on the curve at x, kept in frame order; returns its index.
fn vol_add(x, y) {
    let f = math_round(x_to_frame(x));
    let pts = r_vpts[sel];
    let out = [];
    let at = -1;
    for (let i = 0; i < count(pts); i += 1) {
        if (at < 0 && f < pts[i][0]) { at = count(out); push(out, [f, y_vol(y)]); }
        push(out, pts[i]);
    }
    if (at < 0) { at = count(out); push(out, [f, y_vol(y)]); }
    r_vpts[sel] = out;
    vol_sync(sel);
    return at;
}

fn vol_remove(i) {
    let pts = r_vpts[sel];
    let out = [];
    for (let k = 0; k < count(pts); k += 1) {
        if (k != i) { push(out, pts[k]); }
    }
    r_vpts[sel] = out;
    vol_sync(sel);
}

// Move a point; it stays between its neighbours so the order never flips.
fn vol_drag(i, x, y) {
    let pts = r_vpts[sel];
    let lo = 0;
    let hi = r_frames[sel];
    if (i > 0) { lo = pts[i - 1][0] + 1; }
    if (i + 1 < count(pts)) { hi = pts[i + 1][0] - 1; }
    r_vpts[sel][i][0] = math_clamp(math_round(x_to_frame(x)), lo, hi);
    r_vpts[sel][i][1] = y_vol(y);
    vol_sync(sel);
}

fn editor_down(x, y, button) {
    if (r_node[sel] < 0) { return; }
    if (y >= SEG_Y && y < SEG_Y + SEG_H) {
        if (button == 0) {
            push_undo("");
            seg_strip_click(x);
        }
        return;
    }
    // volume curve first: its points, then the line itself
    if (y < EY + EH) {
        let vp = vol_point_near(x, y);
        if (vp >= 0) {
            push_undo("");
            if (button == 1) { vol_remove(vp); }
            else { drag_vol = vp; }
            return;
        }
        let fx = x_to_frame(x);
        if (button == 0 && math_abs(vol_y(vol_at(r_vpts[sel], fx)) - y) <= 6) {
            push_undo("");
            drag_vol = vol_add(x, y);
            return;
        }
    }
    let k = mark_near(x);
    if (button == 1) {
        if (k > 0) {
            push_undo("");
            delete_mark(k);
        }
        return;
    }
    push_undo("");
    if (k != NO_MARK) { drag_mark = k; }
    else { add_mark(x); }
}

// Second click on the same reset button within CONFIRM_MS: go. First: arm it.
let armed = "";
let armed_at = 0;
fn confirmed(what) {
    let now = timestamp_ms();
    if (armed == what && now - armed_at < CONFIRM_MS) {
        armed = "";
        return true;
    }
    armed = what;
    armed_at = now;
    return false;
}

fn handle_mouse() {
    let evs = cv.events();
    for (let i = 0; i < count(evs); i += 1) {
        let e = evs[i];
        let x = e["x"];
        let y = e["y"];
        if (e["key"] != nil) {
            if (e["key"] == "Z" && e["cmd"]) {
                if (e["shift"]) { redo(); } else { undo(); }
            }
            continue;
        }
        if (!e["down"]) {
            if (e["button"] == 0) {
                label_up(y);
                grid_up(x);
                drag_mark = NO_MARK;
                drag_vol = -1;
            }
            continue;
        }
        if (y >= GY && y < GY + N_ROWS * ROW_STEP) {
            let r = math_floor((y - GY) / ROW_STEP);
            if (y - GY - r * ROW_STEP < ROW_H) { grid_down(r, x, e["button"]); }
        } else if (y >= STRIP_Y && y < STRIP_Y + 26 && e["button"] == 0) {
            if (x >= RT_X && x < RT_X + RT_W) {
                if (confirmed("track")) {
                    push_undo("");
                    reset_track(sel);
                }
            } else if (x >= RS_X && x < RS_X + RS_W) {
                if (confirmed("session")) {
                    push_undo("");
                    reset_session();
                }
            } else {
                let g = math_floor((x - GS_X) / GS_STEP);
                if (x >= GS_X && g < 4 && x - GS_X - g * GS_STEP < GS_W) {
                    for (let r = 0; r < N_ROWS; r += 1) {
                        if (r_grp[r] == g) { press(r, STOP, 0); }
                    }
                }
            }
        } else if (y >= EY && y < SEG_Y + SEG_H) {
            editor_down(x, y, e["button"]);
        }
    }
    if (drag_mark != NO_MARK && cv.mouse_down()) { move_mark(drag_mark, cv.mouse_x()); }
    if (drag_vol >= 0 && cv.mouse_down()) { vol_drag(drag_vol, cv.mouse_x(), cv.mouse_y()); }
}

// ── UI: widgets ─────────────────────────────────────────────────────────────

fn refresh_presets() {
    let files = dir_scan(os_script_dir());
    preset_names = [];
    if (files) {
        for (let i = 0; i < count(files); i += 1) {
            let f = files[i];
            if (str_ends_with("__mlr.json", f)) {
                push(preset_names, str_substr(f, 0, str_length(f) - 10));
            }
        }
    }
    if (count(preset_names) == 0) { w_presets.set_options(["-"]); }
    else { w_presets.set_options(preset_names); }
}

fn preset_path(name) {
    return os_script_dir() + "/" + name + "__mlr.json";
}

// Everything a preset holds, as a value (also what undo snapshots).
fn session_data() {
    let rows = [];
    for (let r = 0; r < N_ROWS; r += 1) {
        push(rows, [
            "file" => r_file[r], "marks" => r_marks[r], "steps" => r_steps[r],
            "step_len" => r_len_i[r], "speed" => r_speed_i[r], "pitch" => r_pitch[r],
            "reverse" => r_rev[r], "play" => PLAY_NAMES[r_play[r]], "mode" => r_mode[r], "group" => r_grp[r],
            "mute" => r_mute[r], "vol" => r_vol[r], "lo" => r_lo[r], "hi" => r_hi[r],
            "end" => r_end[r], "amp_env_on" => r_aon[r], "amp_env" => r_aenv[r], "flt_env" => r_fenv[r],
            "flt_type" => r_ftype[r], "flt_freq" => r_fcut[r], "flt_res" => r_fres[r], "flt_amt" => r_famt[r],
            "drive" => r_drive[r], "drive_type" => DRIVE_NAMES[r_dtype[r]],
            "grain" => r_grain[r], "spray" => r_spray[r], "vol_pts" => r_vpts[r],
        ]);
    }
    let pats = [];
    for (let k = 0; k < 2; k += 1) {
        let evs = pat_ev0;
        if (k == 1) { evs = pat_ev1; }
        let rel = [];
        for (let i = 0; i < count(evs); i += 1) {
            let e = evs[i];
            push(rel, [math_max(0, e[0] - pat_start[k]), e[1], e[2], e[3]]);
        }
        push(pats, ["len" => pat_len[k], "events" => rel]);
    }
    return [
        "version" => 1, "bpm" => bpm(),
        "groups" => [g_vol, g_rev, g_dly], "group_outs" => g_out,
        "rev_out" => rev_out, "dly_out" => dly_out,
        "main" => main_vol, "rev_room" => rev_room, "dly_time" => DLY_NAMES[dly_i], "dly_fb" => dly_fb,
        "rev_type" => REV_NAMES[rev_type], "rev_lpf" => rev_lpf,
        "rows" => rows, "patterns" => pats,
    ];
}

fn save_preset(name) {
    file_write(preset_path(name), json_encode(session_data()));
    status_text = "saved " + name;
    refresh_presets();
}

// Position of `name` in `names`, or `fallback`.
fn name_index(names, name, fallback) {
    for (let i = 0; i < count(names); i += 1) {
        if (names[i] == name) { return i; }
    }
    return fallback;
}

// Delay time of a preset: stored by name, or by index in older presets.
fn dly_index(v) {
    if (v == "" + v) { return name_index(DLY_NAMES, v, DLY_DEFAULT); }
    return name_index(DLY_NAMES, DLY_NAMES_V1[v], DLY_DEFAULT);
}

// Play mode of a saved row: stored by name, or by index in older presets.
fn play_index(row) {
    if (!has_key(row, "play")) { return PLAY_LOOP; }
    let name = row["play"];
    if (name == "" + name) {
        for (let i = 0; i < count(PLAY_NAMES); i += 1) {
            if (PLAY_NAMES[i] == name) { return i; }
        }
        return PLAY_LOOP;
    }
    let old = PLAY_NAMES_V1[name];
    for (let i = 0; i < count(PLAY_NAMES); i += 1) {
        if (PLAY_NAMES[i] == old) { return i; }
    }
    return PLAY_LOOP;
}

// Before loading a session: a row that's playing its own track hands it to its
// ghost slot and keeps playing it (same synth, same thread, no gap).
fn ghost_if_playing(r) {
    if (!r_playing[r] || ps[r] != r || r_node[r] < 0) { return; }
    let g = r + N_ROWS;
    r_file[g] = r_file[r];
    r_buf[g] = r_buf[r];
    r_node[g] = r_node[r];
    r_frames[g] = r_frames[r];
    r_sr[g] = r_sr[r];
    r_peaks[g] = r_peaks[r];
    r_onsets[g] = r_onsets[r];
    r_fbpm[g] = r_fbpm[r];
    r_marks[g] = r_marks[r];
    r_steps[g] = r_steps[r];
    r_end[g] = r_end[r];
    r_vpts[g] = r_vpts[r];
    r_vbuf[g] = r_vbuf[r];
    r_total[g] = r_total[r];
    r_mini[g] = r_mini[r];
    r_cellseg[g] = r_cellseg[r];
    r_len_i[g] = r_len_i[r];
    r_speed_i[g] = r_speed_i[r];
    r_pitch[g] = r_pitch[r];
    r_rev[g] = r_rev[r];
    r_play[g] = r_play[r];
    r_mode[g] = r_mode[r];
    r_grain[g] = r_grain[r];
    r_spray[g] = r_spray[r];
    r_chans[g] = r_chans[r];
    r_grp[g] = r_grp[r];
    r_mute[g] = r_mute[r];
    r_vol[g] = r_vol[r];
    r_aon[g] = r_aon[r];
    r_aenv[g] = r_aenv[r];
    r_fenv[g] = r_fenv[r];
    r_ftype[g] = r_ftype[r];
    r_fcut[g] = r_fcut[r];
    r_fres[g] = r_fres[r];
    r_famt[g] = r_famt[r];
    r_drive[g] = r_drive[r];
    r_dtype[g] = r_dtype[r];
    r_lo[g] = r_lo[r];
    r_hi[g] = r_hi[r];
    r_mix[g] = r_mix[r];
    ps[r] = g;                 // the row thread follows the ghost from here
    r_node[r] = -1;            // the synth + buffers now belong to the ghost
    r_buf[r] = -1;
    r_vbuf[r] = -1;
}

// Fade a ghost out and free its synth and buffers.
fn free_ghost(g) {
    let node = r_node[g];
    let b = r_buf[g];
    let vb = r_vbuf[g];
    r_node[g] = -1;
    r_buf[g] = -1;
    r_vbuf[g] = -1;
    r_file[g] = "";
    thread mlr_ghost_free {
        if (node >= 0) {
            set(node, amp: 0);
            wait_ms(40);
            free(node);
        }
        sleep_ms(latency() + 200);     // the free has landed: buffers can go
        if (b >= 0) { buffer_free(b); }
        if (vb >= 0) { buffer_free(vb); }
    }
}

// Mixer settings + bpm of a session onto the current mixer.
fn apply_mixer(data) {
    bpm(data["bpm"]);
    g_vol = data["groups"][0];
    g_rev = data["groups"][1];
    g_dly = data["groups"][2];
    main_vol = data["main"];
    rev_room = data["rev_room"];
    dly_i = dly_index(data["dly_time"]);
    rev_type = 0;
    rev_lpf = 1;
    if (has_key(data, "rev_type")) {
        rev_type = name_index(REV_NAMES, data["rev_type"], 0);
        rev_lpf = data["rev_lpf"];
    }
    dly_fb = data["dly_fb"];
    if (has_key(data, "group_outs")) {
        g_out = data["group_outs"];
        rev_out = data["rev_out"];
        dly_out = data["dly_out"];
    }
    mixer_update();
    main_update();
}

// One saved row onto row r. reload: always load the file fresh (preset load);
// otherwise keep it when it's the same file (undo). Returns false when the
// file is missing.
fn apply_row(r, row, reload) {
    let was_grain = is_grain(r_mode[r]);
    // settings that don't depend on the file (kept even if it's missing)
    r_speed_i[r] = row["speed"];
    r_pitch[r] = row["pitch"];
    r_rev[r] = row["reverse"];
    r_play[r] = play_index(row);
    r_mode[r] = row["mode"];
    r_grp[r] = row["group"];
    r_mute[r] = row["mute"];
    r_vol[r] = row["vol"];
    r_aon[r] = false;
    r_aenv[r] = [0.1, 0.5, 1, 0.3];
    r_fenv[r] = [0.1, 0.5, 0, 0.3];
    r_ftype[r] = 0;
    r_fcut[r] = 0.8;
    r_fres[r] = 0.2;
    r_famt[r] = 0.5;
    r_drive[r] = 0;
    r_dtype[r] = 0;
    r_grain[r] = 0.5;
    r_spray[r] = 0.3;
    if (has_key(row, "grain")) {
        r_grain[r] = row["grain"];
        r_spray[r] = row["spray"];
    }
    if (has_key(row, "drive")) {
        r_drive[r] = row["drive"];
        r_dtype[r] = name_index(DRIVE_NAMES, row["drive_type"], 0);
    }
    if (has_key(row, "amp_env")) {
        r_aon[r] = row["amp_env_on"];
        r_aenv[r] = row["amp_env"];
        r_fenv[r] = row["flt_env"];
        r_ftype[r] = row["flt_type"];
        r_fcut[r] = row["flt_freq"];
        r_fres[r] = row["flt_res"];
        r_famt[r] = row["flt_amt"];
    }
    let keep = !reload && row["file"] != "" && row["file"] == r_file[r] && r_node[r] >= 0;
    if (keep) {
        if (is_grain(r_mode[r]) != was_grain) { swap_voice(r); }
    } else if (row["file"] == "" || !file_exists(row["file"]) || !load_row(r, row["file"])) {
        unload_row(r);
        r_len_i[r] = row["step_len"];
        return row["file"] == "";
    }
    // tied to the file; after load_row, which sets its own for a fresh file
    r_len_i[r] = row["step_len"];
    r_marks[r] = row["marks"];
    r_steps[r] = row["steps"];
    if (has_key(row, "end")) { r_end[r] = row["end"]; }
    r_vpts[r] = [];
    if (has_key(row, "vol_pts")) { r_vpts[r] = row["vol_pts"]; }
    vol_sync(r);
    r_lo[r] = row["lo"];
    r_hi[r] = row["hi"];
    rebuild_row(r);
    return true;
}

fn load_preset(name) {
    let text = file_read(preset_path(name));
    if (!text) { status_text = "can't read " + name; return; }
    let data = json_decode(text);
    // playing tracks become ghosts and keep playing through their own mixer;
    // the new session gets a free mixer before any of its settings apply
    for (let r = 0; r < N_ROWS; r += 1) { ghost_if_playing(r); }
    cur_mix = pick_mixer();
    loads += 1;
    mix_used[cur_mix] = loads;
    for (let r = 0; r < N_ROWS; r += 1) { r_mix[r] = cur_mix; }
    apply_mixer(data);
    let missing = 0;
    for (let r = 0; r < N_ROWS; r += 1) {
        if (!apply_row(r, data["rows"][r], true)) { missing += 1; }
    }
    for (let k = 0; k < 2; k += 1) {
        pat_rec[k] = false;
        pat_play[k] = false;
        pat_start[k] = 0;
        pat_len[k] = data["patterns"][k]["len"];
    }
    pat_ev0 = data["patterns"][0]["events"];
    pat_ev1 = data["patterns"][1]["events"];
    w_p1_rec.set(false); w_p1_play.set(false);
    w_p2_rec.set(false); w_p2_play.set(false);
    sync_row_widgets();
    sync_mixer_widgets();
    status_text = "loaded " + name;
    w_name.set(name);                          // save goes back to the same preset
    if (missing > 0) { status_text += " (" + missing + " files missing)"; }
}

// ── Undo / redo ─────────────────────────────────────────────────────────────
// A snapshot of the session (session_data) before every edit, 50 deep.
// Repeated changes of the same widget within UNDO_MERGE_MS are one step, so a
// knob turn undoes in one go. Playing, stopping and patterns aren't edits.

let MAX_UNDO = 50;
let UNDO_MERGE_MS = 1500;
let undo_stack = [];
let redo_stack = [];
let undo_tag = "";
let undo_at = 0;

// Call before an edit. tag: the widget's name to merge repeats, "" = always a new step.
fn push_undo(tag) {
    let now = timestamp_ms();
    if (tag != "" && tag == undo_tag && now - undo_at < UNDO_MERGE_MS) {
        undo_at = now;
        return;
    }
    undo_tag = tag;
    undo_at = now;
    push(undo_stack, session_data());
    if (count(undo_stack) > MAX_UNDO) {
        let keep = [];
        for (let i = 1; i < count(undo_stack); i += 1) { push(keep, undo_stack[i]); }
        undo_stack = keep;
    }
    redo_stack = [];
}

// Put a snapshot back in place: same files stay loaded, nothing becomes a ghost.
fn restore_session(data) {
    apply_mixer(data);
    for (let r = 0; r < N_ROWS; r += 1) { apply_row(r, data["rows"][r], false); }
    sync_row_widgets();
    sync_mixer_widgets();
}

fn undo() {
    if (count(undo_stack) == 0) { status_text = "nothing to undo"; return; }
    push(redo_stack, session_data());
    restore_session(pop(undo_stack));
    undo_tag = "";
    status_text = "undo (" + count(undo_stack) + " left)";
}

fn redo() {
    if (count(redo_stack) == 0) { status_text = "nothing to redo"; return; }
    push(undo_stack, session_data());
    restore_session(pop(redo_stack));
    undo_tag = "";
    status_text = "redo (" + count(redo_stack) + " left)";
}

// Every track setting back to how a fresh row starts (file etc. are cleared
// by unload_row).
fn row_defaults(r) {
    r_marks[r] = [0]; r_steps[r] = [MAX_STEPS]; r_end[r] = 0; r_vpts[r] = [];
    r_total[r] = 0; r_mini[r] = []; r_cellseg[r] = [];
    r_len_i[r] = 1; r_speed_i[r] = 2; r_pitch[r] = 0; r_rev[r] = false; r_play[r] = PLAY_LOOP;
    r_mode[r] = MODE_VARI; r_grain[r] = 0.5; r_spray[r] = 0.3; r_chans[r] = 2;
    r_grp[r] = 0; r_mute[r] = false; r_vol[r] = 0.8;
    r_aon[r] = false; r_aenv[r] = [0.1, 0.5, 1, 0.3]; r_fenv[r] = [0.1, 0.5, 0, 0.3];
    r_ftype[r] = 0; r_fcut[r] = 0.8; r_fres[r] = 0.2; r_famt[r] = 0.5;
    r_drive[r] = 0; r_dtype[r] = 0; r_lo[r] = -1; r_hi[r] = -1;
}

// Blank track: stop it (and a ghost on it), remove the file, defaults.
fn reset_track(r) {
    press(r, STOP, 0);
    unload_row(r);
    row_defaults(r);
    if (r == sel) { sync_row_widgets(); }
    status_text = "row " + (r + 1) + " reset";
}

// Like starting the app: all rows blank, patterns cleared, every mixer and the bpm at defaults.
fn reset_session() {
    for (let r = 0; r < N_ROWS; r += 1) { press(r, STOP, 0); }
    for (let r = 0; r < N_ROWS; r += 1) {
        unload_row(r);
        row_defaults(r);
    }
    for (let k = 0; k < 2; k += 1) {
        pat_rec[k] = false; pat_play[k] = false; pat_len[k] = 0; pat_start[k] = 0;
    }
    pat_ev0 = []; pat_ev1 = [];
    w_p1_rec.set(false); w_p1_play.set(false); w_p2_rec.set(false); w_p2_play.set(false);
    g_vol = [0.8, 0.8, 0.8, 0.8]; g_rev = [0, 0, 0, 0]; g_dly = [0, 0, 0, 0]; g_out = [0, 0, 0, 0];
    rev_out = 0; dly_out = 0; main_vol = 0.8; rev_room = 0.6; rev_type = 0; rev_lpf = 1;
    dly_i = DLY_DEFAULT; dly_fb = 0.4;
    bpm(120);
    for (let m = 0; m < N_MIX; m += 1) {
        cur_mix = m;
        mixer_update();
        main_update();
    }
    cur_mix = 0;
    for (let r = 0; r < N_SLOTS; r += 1) { r_mix[r] = 0; }
    sel = 0;
    sync_row_widgets();
    sync_mixer_widgets();
    w_name.set("my_session");
    status_text = "session reset";
}

fn pattern_rec_toggle(k, on) {
    if (on) {
        pat_play[k] = false;
        if (k == 0) { w_p1_play.set(false); pat_ev0 = []; }
        else        { w_p2_play.set(false); pat_ev1 = []; }
        pat_len[k] = 0;
        pat_rec[k] = true;
    } else {
        // play first, then stop recording: playback picks up seamlessly
        pat_play[k] = true;
        if (k == 0) { w_p1_play.set(true); } else { w_p2_play.set(true); }
        pat_rec[k] = false;
    }
}

fn handle_widgets() {
    if (w_file.has_changed() && w_file.value() != "") { push_undo(""); load_row(sel, w_file.value()); }
    if (w_step.has_changed())  { push_undo("step");
        r_len_i[sel] = int(w_step.value());
        fit_steps(sel);
        rebuild_row(sel);
    }
    if (w_speed.has_changed()) { push_undo("speed"); r_speed_i[sel] = int(w_speed.value()); }
    if (w_pitch.has_changed()) { push_undo("pitch"); r_pitch[sel] = math_round(w_pitch.value()); }
    if (w_dir.has_changed())   { push_undo("dir"); r_rev[sel] = int(w_dir.value()) == 1; }
    if (w_play.has_changed())  { push_undo("play"); r_play[sel] = int(w_play.value()); }
    if (w_mode.has_changed())  { push_undo("mode");
        let was_grain = is_grain(r_mode[sel]);
        r_mode[sel] = int(w_mode.value());
        if (is_grain(r_mode[sel]) != was_grain) { swap_voice(sel); }
    }
    if (w_grain.has_changed()) { push_undo("grain"); r_grain[sel] = w_grain.value(); }
    if (w_spray.has_changed()) { push_undo("spray"); r_spray[sel] = w_spray.value(); }
    if (w_group.has_changed()) { push_undo("group"); r_grp[sel] = int(w_group.value()); }
    if (w_vol.has_changed())   { push_undo("vol"); r_vol[sel] = w_vol.value(); }
    if (w_slice.has_changed() && r_node[sel] >= 0) { push_undo(""); slice_row(sel); }
    if (w_amp_on.has_changed()) { push_undo("amp_on"); r_aon[sel] = w_amp_on.value(); }
    // moving an amp knob switches the amp envelope on
    let amp_moved = false;
    if (w_aa.has_changed()) { push_undo("aa"); r_aenv[sel][0] = w_aa.value(); amp_moved = true; }
    if (w_ad.has_changed()) { push_undo("ad"); r_aenv[sel][1] = w_ad.value(); amp_moved = true; }
    if (w_as.has_changed()) { push_undo("as"); r_aenv[sel][2] = w_as.value(); amp_moved = true; }
    if (w_ar.has_changed()) { push_undo("ar"); r_aenv[sel][3] = w_ar.value(); amp_moved = true; }
    if (amp_moved && !r_aon[sel]) {
        r_aon[sel] = true;
        w_amp_on.set(true);
    }
    if (w_fa.has_changed()) { push_undo("fa"); r_fenv[sel][0] = w_fa.value(); }
    if (w_fd.has_changed()) { push_undo("fd"); r_fenv[sel][1] = w_fd.value(); }
    if (w_fs.has_changed()) { push_undo("fs"); r_fenv[sel][2] = w_fs.value(); }
    if (w_fr.has_changed()) { push_undo("fr"); r_fenv[sel][3] = w_fr.value(); }
    if (w_ftype.has_changed()) { push_undo("ftype"); r_ftype[sel] = int(w_ftype.value()); }
    if (w_fcut.has_changed()) { push_undo("fcut"); r_fcut[sel] = w_fcut.value(); }
    if (w_fres.has_changed()) { push_undo("fres"); r_fres[sel] = w_fres.value(); }
    if (w_famt.has_changed()) { push_undo("famt"); r_famt[sel] = w_famt.value(); }
    if (w_drive.has_changed()) { push_undo("drive"); r_drive[sel] = w_drive.value(); }
    if (w_dtype.has_changed()) { push_undo("dtype"); r_dtype[sel] = int(w_dtype.value()); }

    if (w_p1_rec.has_changed())  { pattern_rec_toggle(0, w_p1_rec.value()); }
    if (w_p2_rec.has_changed())  { pattern_rec_toggle(1, w_p2_rec.value()); }
    if (w_p1_play.has_changed()) { pat_play[0] = w_p1_play.value(); }
    if (w_p2_play.has_changed()) { pat_play[1] = w_p2_play.value(); }

    if (w_save.has_changed()) {
        let name = str_trim(w_name.value());
        if (name == "") { status_text = "type a preset name first"; }
        else { save_preset(name); }
    }
    if (w_load.has_changed() && count(preset_names) > 0) {
        push_undo("");
        load_preset(preset_names[int(w_presets.value())]);
    }

    let mix = false;
    if (w_g1_vol.has_changed()) { push_undo("g1_vol"); g_vol[0] = w_g1_vol.value(); mix = true; }
    if (w_g1_rev.has_changed()) { push_undo("g1_rev"); g_rev[0] = w_g1_rev.value(); mix = true; }
    if (w_g1_dly.has_changed()) { push_undo("g1_dly"); g_dly[0] = w_g1_dly.value(); mix = true; }
    if (w_g2_vol.has_changed()) { push_undo("g2_vol"); g_vol[1] = w_g2_vol.value(); mix = true; }
    if (w_g2_rev.has_changed()) { push_undo("g2_rev"); g_rev[1] = w_g2_rev.value(); mix = true; }
    if (w_g2_dly.has_changed()) { push_undo("g2_dly"); g_dly[1] = w_g2_dly.value(); mix = true; }
    if (w_g3_vol.has_changed()) { push_undo("g3_vol"); g_vol[2] = w_g3_vol.value(); mix = true; }
    if (w_g3_rev.has_changed()) { push_undo("g3_rev"); g_rev[2] = w_g3_rev.value(); mix = true; }
    if (w_g3_dly.has_changed()) { push_undo("g3_dly"); g_dly[2] = w_g3_dly.value(); mix = true; }
    if (w_g4_vol.has_changed()) { push_undo("g4_vol"); g_vol[3] = w_g4_vol.value(); mix = true; }
    if (w_g4_rev.has_changed()) { push_undo("g4_rev"); g_rev[3] = w_g4_rev.value(); mix = true; }
    if (w_g4_dly.has_changed()) { push_undo("g4_dly"); g_dly[3] = w_g4_dly.value(); mix = true; }
    if (w_g1_out.has_changed()) { push_undo("g1_out"); g_out[0] = int(w_g1_out.value()); mix = true; }
    if (w_g2_out.has_changed()) { push_undo("g2_out"); g_out[1] = int(w_g2_out.value()); mix = true; }
    if (w_g3_out.has_changed()) { push_undo("g3_out"); g_out[2] = int(w_g3_out.value()); mix = true; }
    if (w_g4_out.has_changed()) { push_undo("g4_out"); g_out[3] = int(w_g4_out.value()); mix = true; }
    if (w_rev_out.has_changed()) { push_undo("rev_out"); rev_out = int(w_rev_out.value()); mix = true; }
    if (w_dly_out.has_changed()) { push_undo("dly_out"); dly_out = int(w_dly_out.value()); mix = true; }
    if (w_main.has_changed())   { push_undo("main"); main_vol = w_main.value(); main_update(); }
    if (w_room.has_changed())   { push_undo("room"); rev_room = w_room.value(); mix = true; }
    if (w_dtime.has_changed())  { push_undo("dtime"); dly_i = int(w_dtime.value()); mix = true; }
    if (w_rtype.has_changed())  { push_undo("rtype"); rev_type = int(w_rtype.value()); mix = true; }
    if (w_rlpf.has_changed())   { push_undo("rlpf"); rev_lpf = w_rlpf.value(); mix = true; }
    if (w_dfb.has_changed())    { push_undo("dfb"); dly_fb = w_dfb.value(); mix = true; }
    if (w_bpm.has_changed())    { push_undo("bpm"); bpm(w_bpm.value()); mix = true; }
    if (mix) { mixer_update(); }
}

// ── UI: drawing ─────────────────────────────────────────────────────────────

fn box(x, y, w, h, c) { cv.rect(x, y, w, h, c[0], c[1], c[2]); }
fn txt(x, y, s, size, c) { cv.text(x, y, s, size, c[0], c[1], c[2]); }
fn ln(x1, y1, x2, y2, c, w) { cv.line(x1, y1, x2, y2, c[0], c[1], c[2], w); }

fn draw_row(r) {
    let y = GY + r * ROW_STEP;
    let dragging_onto = drag_label >= 0 && drag_label != r && cv.mouse_down()
        && math_floor((cv.mouse_y() - GY) / ROW_STEP) == r;
    let gc = GROUP_COLORS[r_grp[r]];
    let total = r_total[r];

    // label
    if (r == sel) { box(4, y, GX - 10, ROW_H, C_CELL_B); }
    else { box(4, y, GX - 10, ROW_H, C_PANEL); }
    box(4, y, 3, ROW_H, gc);
    if (dragging_onto) { box(4, y, GX - 10, ROW_H, C_INFO); }
    txt(14, y + 4, "" + (r + 1), 14, C_TEXT);
    txt(GX - 30, y + 4, PLAY_TAGS[r_play[r]], 11, C_INFO);
    if (r_file[r] != "") { txt(14, y + 23, str_substr(file_name(r_file[r]), 0, 9), 10, C_DIM); }

    // cells
    let cur = r_cell[r];
    if (r_ph[r] < 0) { cur = -1; }
    let mini = r_mini[r];
    let cellseg = r_cellseg[r];
    let in_range = r_lo[r] >= 0;
    for (let c = 0; c < MAX_STEPS; c += 1) {
        let x = GX + c * CELL;
        if (c >= total) {
            box(x, y, CELL - 3, ROW_H, C_OFF);
            continue;
        }
        let col = C_CELL_A;
        if (cellseg[c] % 2 == 1) { col = C_CELL_B; }
        if (in_range && c >= r_lo[r] && c <= r_hi[r]) { col = C_RANGE; }
        let bar = C_WAVE;
        if (c == cur && r_playing[r]) {
            col = C_ACCENT;
            if (ps[r] != r) { col = C_GHOST; }
            bar = C_BG;
        }
        box(x, y, CELL - 3, ROW_H, col);
        if (c > 0 && cellseg[c] != cellseg[c - 1]) { box(x - 3, y, 3, ROW_H, gc); }
        let mid = y + ROW_H / 2;
        for (let j = 0; j < 3; j += 1) {
            let h = mini[c * 3 + j] * (ROW_H / 2 - 4);
            let lx = x + 8 + j * 13;
            ln(lx, mid - h, lx, mid + h, bar, 3);
        }
    }

    // mute, stop, group
    if (r_mute[r]) { box(MX, y, BOX, ROW_H, C_WARN); }
    else { box(MX, y, BOX, ROW_H, C_PANEL); }
    txt(MX + 9, y + 12, "M", 13, C_TEXT);
    if (r_playing[r] && ps[r] != r) { box(SX, y, BOX, ROW_H, C_GHOST); box(SX + 9, y + 15, 10, 10, C_BG); }
    else if (r_playing[r]) { box(SX, y, BOX, ROW_H, C_ACCENT); box(SX + 9, y + 15, 10, 10, C_BG); }
    else { box(SX, y, BOX, ROW_H, C_PANEL); box(SX + 9, y + 15, 10, 10, C_DIM); }
    box(GBX, y, BOX, ROW_H, C_PANEL);
    box(GBX, y + ROW_H - 3, BOX, 3, gc);
    txt(GBX + 4, y + 12, "G" + (r_grp[r] + 1), 12, gc);
}

fn draw_strip() {
    let armed_now = armed != "" && timestamp_ms() - armed_at < CONFIRM_MS;
    let labels = [["track", RT_X, RT_W, "reset track"], ["session", RS_X, RS_W, "reset session"]];
    for (let i = 0; i < 2; i += 1) {
        let b = labels[i];
        if (armed_now && armed == b[0]) {
            box(b[1], STRIP_Y, b[2], 26, C_WARN);
            txt(b[1] + 10, STRIP_Y + 6, "sure?", 12, C_BG);
        } else {
            box(b[1], STRIP_Y, b[2], 26, C_PANEL);
            box(b[1], STRIP_Y, 3, 26, C_WARN);
            txt(b[1] + 10, STRIP_Y + 6, b[3], 11, C_TEXT);
        }
    }
    for (let g = 0; g < 4; g += 1) {
        let gc = GROUP_COLORS[g];
        let x = GS_X + g * GS_STEP;
        box(x, STRIP_Y, GS_W, 26, C_PANEL);
        box(x, STRIP_Y, 3, 26, gc);
        txt(x + 12, STRIP_Y + 6, "stop G" + (g + 1), 12, C_TEXT);
    }
    let info = "";
    for (let k = 0; k < 2; k += 1) {
        let s = "off";
        if (pat_rec[k]) { s = "rec"; }
        else if (pat_play[k] && pat_len[k] > 0) { s = "play " + pat_len[k] + "b"; }
        info += "  P" + (k + 1) + ": " + s;
    }
    txt(GS_X + 4 * GS_STEP, STRIP_Y + 6, info, 11, C_INFO);
}

fn beat_info(r) {
    if (r_fbpm[r] <= 0) { return "   not beaty"; }
    return "   " + math_round(r_fbpm[r] * 10) / 10 + " bpm, " + math_round(sel_beats(r) * 100) / 100 + " beats selected";
}

fn draw_editor() {
    box(EX, EY, EW, EH, C_OFF);
    box(EX, SEG_Y, EW, SEG_H, C_PANEL);
    if (r_node[sel] < 0) {
        txt(EX + 12, EY + 12, "row " + (sel + 1) + ": pick a file on the right", 14, C_DIM);
        return;
    }
    let frames = r_frames[sel];
    let marks = r_marks[sel];
    let steps = r_steps[sel];
    let peaks = r_peaks[sel];
    let n = count(marks);
    let gc = GROUP_COLORS[r_grp[sel]];

    // segment backgrounds + step counts (outside start..end stays dark)
    for (let k = 0; k < n; k += 1) {
        let x0 = frame_to_x(marks[k]);
        let x1 = frame_to_x(r_end[sel]);
        if (k + 1 < n) { x1 = frame_to_x(marks[k + 1]); }
        let col = C_PANEL;
        if (k % 2 == 1) { col = C_CELL_A; }
        if (steps[k] == 0) { col = C_BG; }
        box(x0, EY, x1 - x0, EH, col);
        let cx = (x0 + x1) / 2;
        if (x1 - x0 > 54) {
            txt(x0 + 6, SEG_Y + 5, "-", 14, C_WARN);
            txt(x1 - 16, SEG_Y + 5, "+", 14, C_ACCENT);
        }
        txt(cx - 6, SEG_Y + 5, "" + steps[k], 13, C_TEXT);
    }

    // waveform
    let mid = EY + EH / 2;
    let scale = EH / 2 - 6;
    let top = 0.0001;
    for (let i = 0; i < count(peaks); i += 1) { top = math_max(top, peaks[i]); }
    let xs = frame_to_x(marks[0]);
    let xe = frame_to_x(r_end[sel]);
    for (let i = 0; i < count(peaks); i += 2) {
        let h = math_max(peaks[i], peaks[i + 1]) / top * scale;
        let x = EX + i * EW / PEAKS;
        if (x >= xs && x <= xe) { ln(x, mid - h, x, mid + h, C_WAVE, 2); }
        else { ln(x, mid - h, x, mid + h, C_LINE, 2); }
    }

    // detected hits: small ticks under the waveform
    let onsets = r_onsets[sel];
    for (let i = 0; i < count(onsets); i += 1) {
        let x = frame_to_x(onsets[i]);
        ln(x, EY + EH - 8, x, EY + EH, C_INFO, 1);
    }

    // start (green) and end (red) markers
    let ws = 2;
    if (drag_mark == 0) { ws = 4; }
    ln(xs, EY, xs, SEG_Y + SEG_H, C_ACCENT, ws);
    box(xs, EY, 10, 12, C_ACCENT);
    let we = 2;
    if (drag_mark == END_MARK) { we = 4; }
    ln(xe, EY, xe, SEG_Y + SEG_H, C_WARN, we);
    box(xe - 10, EY, 10, 12, C_WARN);

    // segment markers
    for (let k = 1; k < n; k += 1) {
        let x = frame_to_x(marks[k]);
        let w = 1;
        if (k == drag_mark) { w = 3; }
        ln(x, EY, x, SEG_Y + SEG_H, gc, w);
        box(x - 4, EY, 8, 10, gc);
    }

    // volume curve: a fat line through the points, flat at the ends
    let pts = r_vpts[sel];
    let n_v = count(pts);
    let lx = EX;
    let ly = vol_y(vol_at(pts, 0));
    for (let i = 0; i < n_v; i += 1) {
        let px = frame_to_x(pts[i][0]);
        let py = vol_y(pts[i][1]);
        ln(lx, ly, px, py, C_VOL, 3);
        lx = px;
        ly = py;
    }
    ln(lx, ly, EX + EW, ly, C_VOL, 3);
    for (let i = 0; i < n_v; i += 1) {
        let c = C_VOL;
        if (i == drag_vol) { c = C_TEXT; }
        box(frame_to_x(pts[i][0]) - 4, vol_y(pts[i][1]) - 4, 8, 8, c);
    }

    // playhead (not for a ghost: it plays another file)
    if (r_playing[sel] && ps[sel] == sel) {
        let x = frame_to_x(r_pf[sel]);
        ln(x, EY, x, EY + EH, C_TEXT, 1);
    }
    let total = r_total[sel];
    txt(EX, SEG_Y + SEG_H + 8, file_name(r_file[sel]) + "   " + total + " steps x "
        + STEP_NAMES[r_len_i[sel]] + "   " + math_round(frames / r_sr[sel] * 100) / 100 + " s"
        + beat_info(sel), 12, C_DIM);
}

fn draw() {
    cv.fill(C_BG[0], C_BG[1], C_BG[2]);
    for (let r = 0; r < N_ROWS; r += 1) { draw_row(r); }
    draw_strip();
    draw_editor();
    cv.clear();    // publish this frame
}

// ── Start ───────────────────────────────────────────────────────────────────

fn main() {
    mixer_start();
    sync_row_widgets();
    sync_mixer_widgets();
    w_name.set("my_session");
    refresh_presets();

    for (let r = 0; r < N_ROWS; r += 1) { start_row(r); }
    thread mlr_patterns { pattern_clock(); }

    thread mlr_ui {
        loop {
            handle_mouse();
            handle_widgets();
            if (w_status.value() != status_text) { w_status.set(status_text); }
            draw();
            wait_ms(33);
        }
    }
}
